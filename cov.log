212	fn encode_ico_bmp_subimage(img : @types.Image) -> (Array[Byte], Int, Int) {
213	  let width = img.width
214	  let height = img.height
215	  let channels = img.channels
216	  let data = img.data
217	  let out : Array[Byte] = []
218	  // BITMAPINFOHEADER (40 bytes)
219	  write_u32_le(out, 40) // biSize
220	  write_u32_le(out, width) // biWidth
221	  write_u32_le(out, height * 2) // biHeight = 2*h (XOR + AND)
222	  write_u16_le(out, 1) // biPlanes
223	  write_u16_le(out, 32) // biBitCount
224	  write_u32_le(out, 0) // biCompression = BI_RGB
225	  let xor_size = width * height * 4
226	  write_u32_le(out, xor_size) // biSizeImage
227	  write_u32_le(out, 0) // biXPelsPerMeter
228	  write_u32_le(out, 0) // biYPelsPerMeter
229	  write_u32_le(out, 0) // biClrUsed
230	  write_u32_le(out, 0) // biClrImportant
231	  // XOR 掩码：32-bit BGRA，自下而上
232	  for y in 0..<height {
233	    let ry = height - 1 - y
234	    let row_start = ry * width * channels
235	    for x in 0..<width {
236	      let idx = row_start + x * channels
237	      let r = data[idx].to_int()
238	      let g = if channels >= 2 { data[idx + 1].to_int() } else { r }
