261	fn gmm_distance(
262	  r : Float,
263	  g : Float,
264	  b : Float,
265	  means : Array[(Float, Float, Float)],
266	  vars : Array[(Float, Float, Float)],
267	) -> Float {
268	  let k = means.length()
269	  if k == 0 {
270	    return 1000000.0F	<-- UNCOVERED
271	  }
272	  // 找最近的 GMM 分量（简化：不计算完整概率，用马氏距离）
273	  let mut min_dist = 1000000.0F
274	  for j in 0..<k {
275	    let (mr, mg, mb) = means[j]
276	    let (vr, vg, vb) = vars[j]
277	    let dr = r - mr
278	    let dg = g - mg
279	    let db = b - mb
280	    // 马氏距离（对角协方差）+ log(det)
281	    let det = vr * vg * vb
282	    let log_det = @math.lnf(det)
283	    let dist = dr * dr / vr + dg * dg / vg + db * db / vb + log_det
284	    if dist < min_dist {
285	      min_dist = dist
286	    }
287	  }
288	  min_dist
289	}
