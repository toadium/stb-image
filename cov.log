194	  let mut bit_pos = 8
195	  let data_len = data.length()
196	
197	  fn read_bits(data : Bytes, pos : Int, count : Int, len : Int) -> (Int, Int) {
198	    let mut code : Int = 0
199	    let mut p = pos
200	    let mut i : Int = 0
201	    while i < count && p < len * 8 {
202	      let byte_idx = p / 8
203	      let bit_offset = p % 8
204	      if byte_idx < len {
205	        let bit = (data[byte_idx].to_int() >> bit_offset) & 1
