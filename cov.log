258	fn predict(
259	  x : Int,
260	  y : Int,
261	  width : Int,
262	  pixels : Array[Int],
263	  idx : Int,
264	) -> Int {
265	  if x == 0 && y == 0 {	<-- UNCOVERED
266	    0
267	  } else if y == 0 {
268	    pixels[idx - 1]
269	  } else if x == 0 {
270	    pixels[idx - width]
271	  } else {
272	    let left = pixels[idx - 1]	<-- UNCOVERED
273	    let top = pixels[idx - width]
274	    let tl = pixels[idx - width - 1]
275	    // Average predictor (ClampedAddSubtractFull)
276	    let avg = (left + top) / 2
277	    avg + tl - left - top + avg
278	  }
279	}
