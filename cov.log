 20	    raise @types.LoadError::DecodeFailed("掩码必须为单通道图像")
 21	  }
 22	  let w = img.width
 23	  let h = img.height
 24	  let ch = img.channels
 25	  let n = w * h
 26	  // 构建待修复标记
 27	  let unknown : Array[Bool] = Array::make(n, false)
 28	  let mut has_unknown = false
 29	  for i in 0..<n {
 30	    if mask.data[i] != b'\x00' {
 31	      unknown[i] = true
 32	      has_unknown = true
 33	    }
 34	  }
 35	  // 若无待修复像素，直接返回原图
 36	  if !has_unknown {
 37	    return img
 38	  }
 39	  // 复制原图数据
 40	  let out : Array[Int] = Array::make(n * ch, 0)
