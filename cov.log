 18	pub fn detect_format(data : Bytes) -> @types.ImageFormat {
 19	  let len = data.length()
 20	  if len < 2 {
 21	    return @types.ImageFormat::Unknown	<-- UNCOVERED
 22	  }
 23	  // PNG: 8字节签名
 24	  if len >= 8 &&
 25	    data[0].to_int() == 0x89 &&
 26	    data[1].to_int() == 0x50 &&
 27	    data[2].to_int() == 0x4E &&
 28	    data[3].to_int() == 0x47 &&
