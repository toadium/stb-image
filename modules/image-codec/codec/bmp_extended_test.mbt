///|
test "is_bmp_format: valid BM" {
  let data = Bytes::from_array([
    0x42, 0x4D, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00,
    0x00,
  ])
  assert_true(@codec.is_bmp_format(data))
}

///|
test "is_bmp_format: invalid" {
  let data = Bytes::from_array([0x89, 0x50, 0x4E, 0x47])
  assert_false(@codec.is_bmp_format(data))
}

///|
test "bmp_info_extended: parse 24-bit BMP" {
  // BMP header(14) + DIB(40) for 4x4 24-bit BI_RGB
  let data = Bytes::from_array([
    0x42, 0x4D, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00,
    0x00, 0x28, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
    0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00,
  ])
  let info = @codec.bmp_info_extended(data)
  assert_eq(info.width, 4)
  assert_eq(info.height, 4)
  assert_eq(info.bit_depth, 24)
  assert_eq(info.num_channels, 3)
  assert_false(info.has_alpha)
  assert_eq(info.compression, 0)
  assert_eq(info.compression_name, "BI_RGB")
  assert_true(info.is_bottom_up)
  assert_eq(info.dib_size, 40)
}

///|
test "bmp_info_extended: unsupported format raises" {
  let data = Bytes::from_array([0x89, 0x50, 0x4E, 0x47])
  try {
    ignore(@codec.bmp_info_extended(data))
    assert_true(false)
  } catch {
    _ => assert_true(true)
  }
}
