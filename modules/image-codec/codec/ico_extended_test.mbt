///|
test "is_ico_format: valid" {
  // reserved=0, type=1, count=1, entry: 16x16 32-bit
  let data = Bytes::from_array([
    0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  assert_true(@codec.is_ico_format(data))
}

///|
test "is_ico_format: invalid (CUR)" {
  let data = Bytes::from_array([
    0x00, 0x00, 0x02, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  assert_false(@codec.is_ico_format(data))
}

///|
test "ico_info_extended: parse single 16x16 icon" {
  let data = Bytes::from_array([
    0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  let info = @codec.ico_info_extended(data)
  assert_eq(info.icon_type, 1)
  assert_eq(info.icon_type_name, "ICO")
  assert_eq(info.num_images, 1)
  assert_eq(info.widths[0], 16)
  assert_eq(info.heights[0], 16)
  assert_eq(info.bit_depths[0], 32)
  assert_eq(info.width, 16)
  assert_eq(info.height, 16)
  assert_eq(info.num_channels, 4)
  assert_true(info.has_alpha)
}

///|
test "ico_info_extended: parse multiple icons" {
  // 2 entries: 16x16 32-bit + 32x32 24-bit
  let data = Bytes::from_array([
    0x00, 0x00, 0x01, 0x00, 0x02, 0x00, 0x10, 0x10, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00, 0x20, 0x20, 0x00, 0x00,
    0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00, 0x00,
  ])
  let info = @codec.ico_info_extended(data)
  assert_eq(info.num_images, 2)
  assert_eq(info.widths[0], 16)
  assert_eq(info.widths[1], 32)
  assert_eq(info.width, 32)
  assert_eq(info.height, 32)
}

///|
test "ico_info_extended: 256x256 (width=0 means 256)" {
  let data = Bytes::from_array([
    0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  let info = @codec.ico_info_extended(data)
  assert_eq(info.width, 256)
  assert_eq(info.height, 256)
}

///|
test "ico_info_extended: unsupported format raises" {
  let data = Bytes::from_array([0x89, 0x50, 0x4E, 0x47])
  try {
    ignore(@codec.ico_info_extended(data))
    assert_true(false)
  } catch {
    _ => assert_true(true)
  }
}
