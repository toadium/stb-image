///|
test "is_cur_format: valid" {
  // reserved=0, type=2, count=1, entry: 16x16, hotspot (8,8)
  let data = Bytes::from_array([
    0x00, 0x00, 0x02, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x08, 0x00, 0x08,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  assert_true(@codec.is_cur_format(data))
}

///|
test "is_cur_format: invalid (ICO)" {
  let data = Bytes::from_array([
    0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x01, 0x00, 0x20,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  assert_false(@codec.is_cur_format(data))
}

///|
test "cur_info_extended: parse single cursor" {
  let data = Bytes::from_array([
    0x00, 0x00, 0x02, 0x00, 0x01, 0x00, 0x10, 0x10, 0x00, 0x00, 0x08, 0x00, 0x08,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00,
  ])
  let info = @codec.cur_info_extended(data)
  assert_eq(info.icon_type, 2)
  assert_eq(info.num_images, 1)
  assert_eq(info.widths[0], 16)
  assert_eq(info.heights[0], 16)
  assert_eq(info.hotspot_xs[0], 8)
  assert_eq(info.hotspot_ys[0], 8)
  assert_eq(info.width, 16)
  assert_eq(info.height, 16)
  assert_eq(info.num_channels, 4)
  assert_true(info.has_alpha)
}

///|
test "cur_info_extended: parse multiple cursors" {
  // 2 entries: 16x16 hotspot(8,8) + 32x32 hotspot(16,16)
  let data = Bytes::from_array([
    0x00, 0x00, 0x02, 0x00, 0x02, 0x00, 0x10, 0x10, 0x00, 0x00, 0x08, 0x00, 0x08,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x00, 0x00, 0x00, 0x20, 0x20, 0x00, 0x00,
    0x10, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00, 0x00,
  ])
  let info = @codec.cur_info_extended(data)
  assert_eq(info.num_images, 2)
  assert_eq(info.widths[1], 32)
  assert_eq(info.hotspot_xs[1], 16)
  assert_eq(info.hotspot_ys[1], 16)
  assert_eq(info.width, 32)
}

///|
test "cur_info_extended: unsupported format raises" {
  let data = Bytes::from_array([0x89, 0x50, 0x4E, 0x47])
  try {
    ignore(@codec.cur_info_extended(data))
    assert_true(false)
  } catch {
    _ => assert_true(true)
  }
}
