///|
test "detect_image_format: BMP" {
  let data = Bytes::from_array([
    0x42, 0x4D, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00,
    0x00,
  ])
  assert_eq(@codec.detect_image_format(data), "BMP")
}

///|
test "detect_image_format: PNG" {
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00,
  ])
  assert_eq(@codec.detect_image_format(data), "PNG")
}

///|
test "detect_image_format: JPEG" {
  let data = Bytes::from_array([
    0xFF, 0xD8, 0xFF, 0xC0, 0x00, 0x11, 0x08, 0x00, 0x04, 0x00, 0x04, 0x03, 0x01,
    0x22, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01,
  ])
  assert_eq(@codec.detect_image_format(data), "JPEG")
}

///|
test "detect_image_format: GIF" {
  let data = Bytes::from_array([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x04, 0x00, 0x03, 0x00, 0x81, 0x00, 0x00,
  ])
  assert_eq(@codec.detect_image_format(data), "GIF")
}

///|
test "detect_image_format: QOI" {
  let data = Bytes::from_array([
    0x71, 0x6F, 0x69, 0x66, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x03,
    0x00,
  ])
  assert_eq(@codec.detect_image_format(data), "QOI")
}

///|
test "detect_image_format: unknown" {
  let data = Bytes::from_array([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07])
  assert_eq(@codec.detect_image_format(data), "unknown")
}

///|
test "get_image_info_extended: BMP dispatch" {
  let data = Bytes::from_array([
    0x42, 0x4D, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x36, 0x00, 0x00,
    0x00, 0x28, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
    0x01, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00,
  ])
  let info = @codec.get_image_info_extended(data)
  match info {
    @codec.ImageInfoExtended::Bmp(b) => {
      assert_eq(b.width, 4)
      assert_eq(b.height, 4)
      assert_eq(b.bit_depth, 24)
    }
    _ => assert_true(false)
  }
}

///|
test "get_image_info_extended: PNG dispatch" {
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00,
  ])
  let info = @codec.get_image_info_extended(data)
  match info {
    @codec.ImageInfoExtended::Png(p) => {
      assert_eq(p.width, 4)
      assert_eq(p.height, 4)
      assert_eq(p.bit_depth, 8)
    }
    _ => assert_true(false)
  }
}

///|
test "get_image_info_extended: JPEG dispatch" {
  let data = Bytes::from_array([
    0xFF, 0xD8, 0xFF, 0xC0, 0x00, 0x11, 0x08, 0x00, 0x04, 0x00, 0x04, 0x03, 0x01,
    0x22, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01,
  ])
  let info = @codec.get_image_info_extended(data)
  match info {
    @codec.ImageInfoExtended::Jpeg(j) => {
      assert_eq(j.width, 4)
      assert_eq(j.height, 4)
      assert_eq(j.precision, 8)
    }
    _ => assert_true(false)
  }
}

///|
test "get_image_info_extended: GIF dispatch" {
  let data = Bytes::from_array([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x04, 0x00, 0x03, 0x00, 0x81, 0x00, 0x00,
  ])
  let info = @codec.get_image_info_extended(data)
  match info {
    @codec.ImageInfoExtended::Gif(g) => {
      assert_eq(g.width, 4)
      assert_eq(g.height, 3)
      assert_eq(g.version, "89a")
    }
    _ => assert_true(false)
  }
}

///|
test "get_image_info_extended: QOI dispatch" {
  let data = Bytes::from_array([
    0x71, 0x6F, 0x69, 0x66, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x03,
    0x00,
  ])
  let info = @codec.get_image_info_extended(data)
  match info {
    @codec.ImageInfoExtended::Qoi(q) => {
      assert_eq(q.width, 4)
      assert_eq(q.height, 4)
      assert_eq(q.channels, 3)
    }
    _ => assert_true(false)
  }
}

///|
test "get_image_info_extended: unknown format raises" {
  let data = Bytes::from_array([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07])
  try {
    ignore(@codec.get_image_info_extended(data))
    assert_true(false)
  } catch {
    _ => assert_true(true)
  }
}
