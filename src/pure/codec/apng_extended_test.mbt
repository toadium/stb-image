///|
test "is_apng_format: valid APNG with acTL" {
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x61, 0x63,
    0x54, 0x4C, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  assert_true(@codec.is_apng_format(data))
}

///|
test "is_apng_format: plain PNG without acTL" {
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45,
    0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  assert_false(@codec.is_apng_format(data))
}

///|
test "is_apng_format: invalid" {
  let data = Bytes::from_array([0x42, 0x4D, 0x00, 0x00])
  assert_false(@codec.is_apng_format(data))
}

///|
test "apng_info_extended: parse animated APNG" {
  // PNG sig + IHDR(4x4 RGBA) + acTL(2 frames, 0 plays) + IEND
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x61, 0x63,
    0x54, 0x4C, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  let info = @codec.apng_info_extended(data)
  assert_eq(info.width, 4)
  assert_eq(info.height, 4)
  assert_eq(info.bit_depth, 8)
  assert_eq(info.color_type, 6)
  assert_eq(info.color_type_name, "RGBA")
  assert_eq(info.num_channels, 4)
  assert_true(info.has_alpha)
  assert_eq(info.num_frames, 2)
  assert_eq(info.num_plays, 0)
  assert_true(info.is_animated)
}

///|
test "apng_info_extended: parse single-frame APNG" {
  // PNG sig + IHDR(2x2 RGB) + acTL(1 frame, 5 plays) + IEND
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02, 0x08, 0x02,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x61, 0x63,
    0x54, 0x4C, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  let info = @codec.apng_info_extended(data)
  assert_eq(info.width, 2)
  assert_eq(info.height, 2)
  assert_eq(info.color_type, 2)
  assert_eq(info.color_type_name, "RGB")
  assert_eq(info.num_channels, 3)
  assert_false(info.has_alpha)
  assert_eq(info.num_frames, 1)
  assert_eq(info.num_plays, 5)
  assert_false(info.is_animated)
}

///|
test "apng_info_extended: plain PNG (no acTL)" {
  // PNG sig + IHDR + IEND, no acTL chunk
  let data = Bytes::from_array([
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49,
    0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x04, 0x08, 0x06,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45,
    0x4E, 0x44, 0x00, 0x00, 0x00, 0x00,
  ])
  let info = @codec.apng_info_extended(data)
  assert_eq(info.width, 4)
  assert_eq(info.height, 4)
  assert_eq(info.num_frames, 0)
  assert_false(info.is_animated)
}

///|
test "apng_info_extended: unsupported format raises" {
  let data = Bytes::from_array([0x42, 0x4D, 0x00, 0x00])
  try {
    ignore(@codec.apng_info_extended(data))
    assert_true(false)
  } catch {
    _ => assert_true(true)
  }
}
