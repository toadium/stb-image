name = "MoonBit-Toadium/stb-image"

version = "2.0.0"

license = "MIT"

description = "MoonBit image library: native C FFI (stb_image) + pure MoonBit backend for wasm/js multi-target support."

keywords = [
  "moonbit",
  "image",
  "ffi",
  "native",
  "stb",
  "png",
  "jpeg",
  "bmp",
  "gif",
  "qoi",
  "ico",
  "icns",
  "resize",
  "hdr",
  "wasm",
  "js",
  "pure",
  "multi-target",
]

preferred_target = "native"

readme = "src/README.mbt.md"
