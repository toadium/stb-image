name = "Toadium/image"

version = "2.0.0"

license = "MIT"

description = "MoonBit image library: pure MoonBit backend for native/wasm/js multi-target support."

repository = "https://github.com/toadium/stb-image"

keywords = [
  "moonbit",
  "image",
  "png",
  "jpeg",
  "bmp",
  "gif",
  "qoi",
  "resize",
  "hdr",
  "wasm",
  "js",
  "pure",
  "multi-target",
]

preferred_target = "native"

readme = "src/README.mbt.md"
