187	fn gaussian_gain(
188	  filter_type : FreqFilterType,
189	  dist : Float,
190	  cutoff : Float,
191	  band_width : Float,
192	) -> Float {
193	  let eps = 0.0001F
194	  let c2 = cutoff * cutoff
195	  match filter_type {
196	    LowPass => @math.expf(-(dist * dist) / (c2 + eps))
197	    HighPass => 1.0F - @math.expf(-(dist * dist) / (c2 + eps))
198	    BandPass => {	<-- UNCOVERED
199	      let lp = @math.expf(-(dist * dist) / (c2 + eps))
200	      let lo = cutoff - band_width / 2.0F
201	      let lp2 = @math.expf(-(dist * dist) / (lo * lo + eps))	<-- UNCOVERED
202	      lp2 - lp
203	    }
204	    BandStop => {	<-- UNCOVERED
205	      let lp = @math.expf(-(dist * dist) / (c2 + eps))
206	      let lo = cutoff - band_width / 2.0F
207	      let lp2 = @math.expf(-(dist * dist) / (lo * lo + eps))	<-- UNCOVERED
208	      1.0F - (lp2 - lp)
209	    }
210	  }
