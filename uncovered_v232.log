233	  for col in 0..<n {
234	    // 找主元
235	    let mut max_row = col
236	    let mut max_val = a[col][col].abs()
237	    for row in (col + 1)..<n {
238	      if a[row][col].abs() > max_val {
239	        max_val = a[row][col].abs()
240	        max_row = row
241	      }
242	    }
243	    if max_val < 0.0000000001F {
