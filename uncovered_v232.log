250	pub fn detect_text_regions(
251	  img : @types.Image,
252	) -> TextDetectionResult raise @types.LoadError {
253	  // 输入验证
254	  if img.width <= 0 || img.height <= 0 {
255	    raise @types.LoadError::DecodeFailed(
256	      "detect_text_regions: 图像尺寸必须大于0",
257	    )
258	  }
259	  if img.channels < 1 || img.channels > 4 {
260	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
261	      "detect_text_regions: 通道数必须在1-4之间",
262	    )
263	  }
264	  let expected_size = img.width * img.height * img.channels
265	  if img.data.length() != expected_size {
266	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
267	      "detect_text_regions: 数据大小不匹配",
268	    )
269	  }
270	  let w = img.width
271	  let h = img.height
272	  let total = w * h
273	
274	  // 检测密集小边缘区域（文字特征）
275	  let mut dense_edge_regions = 0
276	  let block_size = 16
277	  let blocks_x = w / block_size
278	  let blocks_y = h / block_size
279	
280	  for by in 0..<blocks_y {
281	    for bx in 0..<blocks_x {
282	      let mut edge_count = 0
283	      for y in 0..<block_size {
284	        for x in 0..<block_size {
285	          let px = bx * block_size + x
286	          let py = by * block_size + y
287	          if px > 0 && px < w - 1 && py > 0 && py < h - 1 {
288	            let idx = py * w + px
289	            let gx = (img.data[idx + 1].to_double() -
290	            img.data[idx - 1].to_double()).abs()
291	            let gy = (img.data[idx + w].to_double() -
292	            img.data[idx - w].to_double()).abs()
293	            if gx > 15.0 || gy > 15.0 {
294	              edge_count += 1
295	            }
296	          }
297	        }
298	      }
299	      let edge_density = edge_count.to_double() /
300	        (block_size * block_size).to_double()
301	      // 文字区域通常边缘密度在 0.15-0.5 之间
302	      if edge_density > 0.15 && edge_density < 0.6 {
303	        dense_edge_regions += 1
304	      }
305	    }
306	  }
307	
308	  let text_area_ratio = dense_edge_regions.to_double() /
309	    (blocks_x * blocks_y).to_double()
310	
311	  // 小边缘密度（全局）
312	  let mut small_edges = 0
313	  for y in 1..<(h - 1) {
314	    for x in 1..<(w - 1) {
315	      let idx = y * w + x
316	      let gx = (img.data[idx + 1].to_double() - img.data[idx - 1].to_double()).abs()
317	      let gy = (img.data[idx + w].to_double() - img.data[idx - w].to_double()).abs()
318	      let mag = (gx * gx + gy * gy).sqrt()
319	      if mag > 10.0 && mag < 80.0 {
320	        small_edges += 1
321	      }
322	    }
323	  }
324	  let small_edge_density = small_edges.to_double() / total.to_double()
325	
326	  // 文字指示值：文字区域越多，越可能是屏幕截图（物理生成）
327	  let text_indicator = if text_area_ratio > 0.15 {
328	    0.85
329	  } else if text_area_ratio > 0.08 {
330	    0.65	<-- UNCOVERED
331	  } else if text_area_ratio > 0.03 {
332	    0.45	<-- UNCOVERED
333	  } else {
334	    0.2
335	  }
336	
337	  TextDetectionResult::{
338	    text_area_count: dense_edge_regions,
339	    text_area_ratio,
340	    dense_edge_region_count: dense_edge_regions,
341	    small_edge_density,
342	    text_like_region_ratio: text_area_ratio,
343	    text_indicator,
344	  }
345	}
