 956	          result[y * 4 + x] = (above[x] + above[x + 1] + left[y] + 1) >> 2
 957	        }
 958	      }
 959	
 960	    // 7: LeftUp 预测（左上/水平-上组合）
 961	    // 水平预测为主，向右上方倾斜
