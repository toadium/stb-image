455	pub fn calculate_image_quality_metrics(
456	  original : @types.Image,
457	  processed : @types.Image,
458	) -> ImageQualityMetrics {
459	  let psnr = calculate_psnr_sr(original, processed)
460	  let ssim = calculate_ssim_sr(original, processed)
461	
462	  let w = original.width
463	  let h = original.height
464	  let total = w * h
465	  let mut mse = 0.0
466	  let mut mae = 0.0
467	  let mut sum1 = 0.0
468	  let mut sum2 = 0.0
469	  let mut sum12 = 0.0
470	
471	  for i in 0..<total {
472	    let p1 = original.data[i].to_double()
473	    let p2 = processed.data[i].to_double()
474	    let diff = p1 - p2
475	    mse += diff * diff
476	    mae += diff.abs()
477	    sum1 += p1
478	    sum2 += p2
479	    sum12 += p1 * p2
480	  }
481	  mse /= total.to_double()
482	  mae /= total.to_double()
483	
484	  let mean1 = sum1 / total.to_double()
485	  let mean2 = sum2 / total.to_double()
486	  let cov = sum12 / total.to_double() - mean1 * mean2
487	  let var1 = if total > 0 {
488	    let mut v = 0.0
489	    for i in 0..<total {
490	      let p = original.data[i].to_double()
491	      v += (p - mean1) * (p - mean1)
492	    }
493	    v / total.to_double()
494	  } else {
495	    0.0	<-- UNCOVERED
496	  }
497	  let var2 = if total > 0 {
498	    let mut v = 0.0
499	    for i in 0..<total {
500	      let p = processed.data[i].to_double()
501	      v += (p - mean2) * (p - mean2)
502	    }
503	    v / total.to_double()
504	  } else {
505	    0.0	<-- UNCOVERED
506	  }
507	  let correlation = if var1 > 0.0 && var2 > 0.0 {
508	    cov / (var1 * var2).sqrt()
509	  } else {
510	    0.0
511	  }
512	
513	  // 清晰度（基于梯度）
514	  let mut sharpness = 0.0
515	  for y in 1..<(h - 1) {
516	    for x in 1..<(w - 1) {
517	      let idx = y * w + x
518	      let gx = processed.data[idx + 1].to_double() -
519	        processed.data[idx - 1].to_double()
520	      let gy = processed.data[idx + w].to_double() -
521	        processed.data[idx - w].to_double()
522	      sharpness += (gx * gx + gy * gy).sqrt()
523	    }
524	  }
525	  sharpness /= total.to_double()
526	
527	  let noise_level = mse.sqrt()
528	  let overall_quality = if psnr > 40.0 && ssim > 0.95 {
529	    5.0
530	  } else if psnr > 30.0 && ssim > 0.9 {
531	    4.0	<-- UNCOVERED
532	  } else if psnr > 20.0 && ssim > 0.8 {
533	    3.0	<-- UNCOVERED
534	  } else {
535	    2.0
536	  }
537	
538	  ImageQualityMetrics::{
539	    psnr,
540	    ssim,
541	    mse,
542	    mae,
543	    correlation,
544	    sharpness,
545	    noise_level,
546	    overall_quality,
547	  }
548	}
