1882	fn vp8_read_ue_golomb(bd : Vp8BoolDecoder) -> Int {
1883	  let mut leading_zeros = 0	<-- UNCOVERED
1884	  while bd.read_bool(128) == 0 {
1885	    leading_zeros += 1
1886	    if leading_zeros > 31 {
1887	      return 0	<-- UNCOVERED
1888	    }
1889	  }
1890	  if leading_zeros == 0 {
1891	    return 0	<-- UNCOVERED
1892	  }
1893	  let mut value = 1
1894	  for _ in 0..<leading_zeros {
1895	    value = (value << 1) | bd.read_bool(128)	<-- UNCOVERED
1896	  }
1897	  value - 1
1898	}
