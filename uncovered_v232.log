161	fn vp8_fwht_4x4(block : Array[Int]) -> Array[Int] {
162	  let result = Array::make(16, 0)	<-- UNCOVERED
163	  // 行变换
164	  for i in 0..<4 {
165	    let a0 = block[i * 4]	<-- UNCOVERED
166	    let a1 = block[i * 4 + 1]
167	    let a2 = block[i * 4 + 2]
168	    let a3 = block[i * 4 + 3]
169	    let b0 = a0 + a1
170	    let b1 = a2 + a3
171	    let b2 = a0 - a1
172	    let b3 = a2 - a3
173	    result[i * 4] = b0 + b1
174	    result[i * 4 + 1] = b2 + b3
175	    result[i * 4 + 2] = b2 - b3
176	    result[i * 4 + 3] = b0 - b1
177	  }
178	  // 列变换
179	  let temp = Array::make(16, 0)	<-- UNCOVERED
180	  for i in 0..<16 {
181	    temp[i] = result[i]	<-- UNCOVERED
182	  }
183	  for j in 0..<4 {
184	    let a0 = temp[j]	<-- UNCOVERED
185	    let a1 = temp[4 + j]
186	    let a2 = temp[8 + j]
187	    let a3 = temp[12 + j]
188	    let b0 = a0 + a1
189	    let b1 = a2 + a3
190	    let b2 = a0 - a1
191	    let b3 = a2 - a3
192	    result[j] = (b0 + b1 + 1) >> 1
193	    result[4 + j] = (b2 + b3 + 1) >> 1
194	    result[8 + j] = (b2 - b3 + 1) >> 1
195	    result[12 + j] = (b0 - b1 + 1) >> 1
196	  }
197	  result
198	}
