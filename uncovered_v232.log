1274	fn vp8_filter_vertical_4(
1275	  plane : Array[Int],
1276	  x : Int,
1277	  y : Int,
1278	  width : Int,
1279	  filter_level : Int,
1280	  inner_level : Int,
1281	) -> Unit {
1282	  if x <= 0 || x >= width {	<-- UNCOVERED
1283	    return
1284	  }
1285	  let idx = y * width + x
1286	  let p1 = plane[idx - 2]
1287	  let p0 = plane[idx - 1]
1288	  let q0 = plane[idx]
1289	  let q1 = plane[idx + 1]
1290	
1291	  // 检查是否需要滤波
1292	  let threshold = filter_level * 2
1293	  if (p0 - q0).abs() * 2 + (p1 - q1).abs() / 2 > threshold {	<-- UNCOVERED
1294	    return
1295	  }
1296	
1297	  // 计算滤波值
1298	  let mut p0_new = p0
1299	  let mut q0_new = q0
1300	  let mut p1_new = p1
1301	  let mut q1_new = q1
1302	
1303	  if filter_level > 0 {
1304	    // 简单的 4 抽头滤波
1305	    let filter_val = (p1 + 2 * p0 + 2 * q0 + q1 + 4) / 8	<-- UNCOVERED
1306	    p0_new = filter_val
1307	    q0_new = filter_val
1308	
1309	    // 如果内部滤波级别足够，也滤波 p1 和 q1
1310	    if inner_level > 0 && (p1 - p0).abs() < inner_level {	<-- UNCOVERED
1311	      p1_new = (p1 + p0_new + 1) / 2
1312	    }
1313	    if inner_level > 0 && (q1 - q0).abs() < inner_level {	<-- UNCOVERED
1314	      q1_new = (q1 + q0_new + 1) / 2
1315	    }
1316	  }
1317	
1318	  plane[idx - 2] = p1_new
1319	  plane[idx - 1] = p0_new
1320	  plane[idx] = q0_new
1321	  plane[idx + 1] = q1_new
1322	}
