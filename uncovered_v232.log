409	  } else {
410	    0.4
411	  }
412	  score += stroke_sim * 0.2
413	
414	  // 宽高比相似度（15%）
415	  let aspect_diff = (feat1.aspect_ratio - feat2.aspect_ratio).abs()
416	  let aspect_sim = if aspect_diff < 0.1 {
417	    1.0
418	  } else if aspect_diff < 0.3 {	<-- UNCOVERED
419	    0.7
420	  } else {
421	    0.4	<-- UNCOVERED
422	  }
423	  score += aspect_sim * 0.15
