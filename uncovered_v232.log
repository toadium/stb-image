192	  let loss = cross_entropy_loss(probs, target)
193	  // 反向传播
194	  let grad_logits = softmax_cross_entropy_backward(probs, target)
195	  let (grad_pool, _, grad_dense_bias) = dense_backward(
196	    grad_logits, dense_weights, flat_size, num_classes,
197	  )
198	  let grad_relu = max_pool2d_backward(
199	    grad_pool, relu_out, conv_out_h, conv_out_w, conv_out_c, 2,
200	  )
201	  let grad_conv = relu_backward(grad_relu, relu_out)
202	  // 更新偏置
203	  let new_dense_bias = update_weights_sgd(
204	    dense_bias, grad_dense_bias, learning_rate,
205	  )
206	  let new_conv_bias : Array[Double] = []
207	  for c in 0..<conv_out_c {
208	    let mut grad_sum = 0.0
209	    for i in 0..<(conv_out_h * conv_out_w) {
210	      let idx = c * conv_out_h * conv_out_w + i
211	      grad_sum += grad_conv[idx]
212	    }
213	    new_conv_bias.push(conv_bias[c] - learning_rate * grad_sum)
214	  }
215	  // 卷积权重更新（简化）
216	  let new_conv_weights : Array[Double] = []
217	  for i in 0..<conv_weights.length() {
218	    let mut grad_w = 0.0
219	    for j in 0..<input.length() {
220	      if j < grad_conv.length() {
221	        grad_w += input[j] * grad_conv[j]
222	      }
223	    }
224	    grad_w = grad_w / input.length().to_double()
225	    new_conv_weights.push(conv_weights[i] - learning_rate * grad_w)
226	  }
227	  // Dense 权重更新
228	  let new_dense_weights : Array[Double] = []
229	  for i in 0..<dense_weights.length() {
230	    let row = i / num_classes
231	    let col = i % num_classes
232	    let grad_w = pool_out[row] * grad_logits[col]
233	    new_dense_weights.push(dense_weights[i] - learning_rate * grad_w)
234	  }
235	  (new_conv_weights, new_conv_bias, new_dense_weights, new_dense_bias, loss)
