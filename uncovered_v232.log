1162	fn Vp8MbModeProbs::update(self : Vp8MbModeProbs) -> Unit {
1163	  self.total_mbs += 1	<-- UNCOVERED
1164	  // 每 16 个宏块更新一次概率
1165	  if self.total_mbs % 16 != 0 {
1166	    return	<-- UNCOVERED
1167	  }
1168	
1169	  // 更新 I16x16 概率
1170	  let i16_total = self.i16x16_count[0] +
1171	    self.i16x16_count[1] +
1172	    self.i16x16_count[2] +
1173	    self.i16x16_count[3] +
1174	    1
1175	  for i in 0..<4 {
1176	    let observed = self.i16x16_count[i] * 256 / i16_total	<-- UNCOVERED
1177	    self.i16x16_prob[i] = (self.i16x16_prob[i] * 7 + observed) / 8
1178	    self.i16x16_count[i] = self.i16x16_count[i] / 2
1179	  }
1180	
1181	  // 更新 I4x4 概率
1182	  let i4_total = self.i4x4_count[0] +
1183	    self.i4x4_count[1] +
1184	    self.i4x4_count[2] +
1185	    self.i4x4_count[3] +
1186	    self.i4x4_count[4] +
1187	    self.i4x4_count[5] +
1188	    self.i4x4_count[6] +
1189	    self.i4x4_count[7] +
1190	    self.i4x4_count[8] +
1191	    self.i4x4_count[9] +
1192	    1
1193	  for i in 0..<10 {
1194	    let observed = self.i4x4_count[i] * 256 / i4_total	<-- UNCOVERED
1195	    self.i4x4_prob[i] = (self.i4x4_prob[i] * 7 + observed) / 8
1196	    self.i4x4_count[i] = self.i4x4_count[i] / 2
1197	  }
1198	
1199	  // 更新 UV 概率
1200	  let uv_total = self.uv_count[0] +
1201	    self.uv_count[1] +
1202	    self.uv_count[2] +
1203	    self.uv_count[3] +
1204	    1
1205	  for i in 0..<4 {
1206	    let observed = self.uv_count[i] * 256 / uv_total	<-- UNCOVERED
1207	    self.uv_prob[i] = (self.uv_prob[i] * 7 + observed) / 8
1208	    self.uv_count[i] = self.uv_count[i] / 2
1209	  }
1210	
1211	  // 更新子宏块类型概率
1212	  let submb_total = self.total_mbs + 1
1213	  let observed_submb = self.submb_type_count * 256 / submb_total
1214	  self.submb_type_prob = (self.submb_type_prob * 7 + observed_submb) / 8
1215	  self.submb_type_count = self.submb_type_count / 2
1216	}
