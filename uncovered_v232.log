103	      let slant_rad = slant * 3.141592653589793 / 180.0
104	      let transformed_x = x.to_double() -
105	        center_x.to_double() -
106	        (y.to_double() - center_y.to_double()) * @math.tan(slant_rad) +
107	        center_x.to_double()
