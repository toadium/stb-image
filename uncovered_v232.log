438	    feat1.center_of_mass_x - feat2.center_of_mass_x,
439	    2.0,
440	  ) +
441	  @math.pow(feat1.center_of_mass_y - feat2.center_of_mass_y, 2.0)).sqrt()
442	  let center_sim = if center_dist < 0.05 {
443	    1.0
444	  } else if center_dist < 0.15 {
445	    0.7	<-- UNCOVERED
446	  } else {
447	    0.4
448	  }
449	  score += center_sim * 0.2
450	
451	  // 倾斜角度相似度（10%）
452	  let slant_diff = (feat1.slant_angle - feat2.slant_angle).abs()
453	  let slant_sim = if slant_diff < 5.0 {
454	    1.0
455	  } else if slant_diff < 15.0 {	<-- UNCOVERED
456	    0.7
457	  } else {
458	    0.4	<-- UNCOVERED
459	  }
460	  score += slant_sim * 0.1
461	
462	  // 轮廓复杂度相似度（10%）
463	  let contour_diff = (feat1.contour_complexity - feat2.contour_complexity).abs()
464	  let contour_sim = if contour_diff < 0.5 {
