349	pub fn analyze_geometry(
350	  img : @types.Image,
351	) -> GeometryAnalysisResult raise @types.LoadError {
352	  // 输入验证
353	  if img.width <= 0 || img.height <= 0 {
354	    raise @types.LoadError::DecodeFailed(
355	      "analyze_geometry: 图像尺寸必须大于0",
356	    )
357	  }
358	  if img.channels < 1 || img.channels > 4 {
359	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
360	      "analyze_geometry: 通道数必须在1-4之间",
361	    )
362	  }
363	  let expected_size = img.width * img.height * img.channels
364	  if img.data.length() != expected_size {
365	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
366	      "analyze_geometry: 数据大小不匹配",
367	    )
368	  }
369	  let w = img.width
370	  let h = img.height
371	
372	  // 边缘方向分析
373	  let mut horizontal_edges = 0
374	  let mut vertical_edges = 0
375	  let mut diagonal_edges = 0
376	  let mut total_edges = 0
377	
378	  for y in 1..<(h - 1) {
379	    for x in 1..<(w - 1) {
380	      let idx = y * w + x
381	      let gx = img.data[idx + 1].to_double() - img.data[idx - 1].to_double()
382	      let gy = img.data[idx + w].to_double() - img.data[idx - w].to_double()
383	      let mag = (gx * gx + gy * gy).sqrt()
384	      if mag > 20.0 {
385	        total_edges += 1
386	        let abs_gx = gx.abs()
387	        let abs_gy = gy.abs()
388	        if abs_gx > abs_gy * 2.0 {
389	          horizontal_edges += 1
390	        } else if abs_gy > abs_gx * 2.0 {
391	          vertical_edges += 1
392	        } else {
393	          diagonal_edges += 1
394	        }
395	      }
396	    }
397	  }
398	
399	  let horizontal_ratio = if total_edges > 0 {
400	    horizontal_edges.to_double() / total_edges.to_double()
401	  } else {
402	    0.0
403	  }
404	  let vertical_ratio = if total_edges > 0 {
405	    vertical_edges.to_double() / total_edges.to_double()
406	  } else {
407	    0.0
408	  }
409	  let diagonal_ratio = if total_edges > 0 {
410	    diagonal_edges.to_double() / total_edges.to_double()
411	  } else {
412	    0.0
413	  }
414	
415	  // 几何规则性：水平+垂直边缘比例越高，越规则（UI 界面特征）
416	  let geometry_regularity = horizontal_ratio + vertical_ratio
417	
418	  // 矩形状区域检测（规则的水平垂直线条交叉）
419	  let rectangle_regions = if geometry_regularity > 0.7 {
420	    total_edges / 100
421	  } else {
422	    0
423	  }
424	
425	  // 几何指示值：几何越规则，越可能是屏幕截图（物理生成）
426	  let geometry_indicator = if geometry_regularity > 0.8 {
427	    0.85
428	  } else if geometry_regularity > 0.65 {
429	    0.65
430	  } else if geometry_regularity > 0.5 {
431	    0.45
432	  } else {
433	    0.25
434	  }
435	
436	  GeometryAnalysisResult::{
437	    horizontal_edge_ratio: horizontal_ratio,
438	    vertical_edge_ratio: vertical_ratio,
439	    diagonal_edge_ratio: diagonal_ratio,
440	    rectangle_like_region_count: rectangle_regions,
441	    straight_line_count: horizontal_edges + vertical_edges,
442	    geometry_regularity,
443	    geometry_indicator,
444	  }
445	}
