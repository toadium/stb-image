429	      "extract_watermark_lsb: 图像尺寸必须大于0",
430	    )
431	  }
432	  if img.channels < 1 || img.channels > 4 {
433	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
434	      "extract_watermark_lsb: 通道数必须在1-4之间",
435	    )
436	  }
437	  let expected_size = img.width * img.height * img.channels
438	  if img.data.length() != expected_size {
439	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
440	      "extract_watermark_lsb: 数据大小不匹配",
441	    )
442	  }
443	  if watermark_length <= 0 {
444	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
445	      "extract_watermark_lsb: 水印长度必须大于0",
446	    )
447	  }
448	  let w = img.width
449	  let h = img.height
450	  let total = w * h
451	  let watermark : Array[Byte] = []
452	  let _ = watermark_length * 8
453	
454	  for byte_idx in 0..<watermark_length {
455	    let mut byte_value = 0
456	    for bit_idx in 0..<8 {
457	      let pixel_idx = byte_idx * 8 + bit_idx
458	      if pixel_idx < total {
459	        let pixel = img.data[pixel_idx].to_int()
460	        let bit = (pixel >> strength) & 1
461	        byte_value = (byte_value << 1) | bit
462	      }
463	    }
464	    watermark.push(byte_value.to_byte())
465	  }
466	
467	  WatermarkExtractionResult::{
468	    watermark_data: watermark,
469	    watermark_width: 0,
470	    watermark_height: 0,
471	    similarity: 1.0,
472	    extracted: true,
473	    extraction_time_ms: 0.0,
474	  }
