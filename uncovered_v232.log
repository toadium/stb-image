688	  for i in 0..<256 {
689	    if histogram[i] > 0 {
690	      let p = histogram[i].to_double() / total.to_double()
691	      entropy -= p * p * 0.1 // 简化的 log2
692	    }
693	  }
694	
695	  // 像素分布越集中（熵越低），越可能是 UI 界面（物理生成）
696	  if entropy < 0.5 {
697	    0.75
698	  } else if entropy < 1.0 {	<-- UNCOVERED
699	    0.55
700	  } else if entropy < 1.5 {
701	    0.35
702	  } else {
703	    0.2	<-- UNCOVERED
704	  }
705	}
