389	          let nx = x + dx
390	          let ny = y + dy
391	          if nx >= 0 && nx < w && ny >= 0 && ny < h {
392	            let current = img.data[ny * w + nx].to_double()
393	            let color_diff = (current - center).abs()
394	            let space_dist = (dx * dx + dy * dy).to_double().sqrt()
395	            // 简化的高斯权重
