339	fn vp8_parse_residual_4x4(
340	  bd : Vp8BoolDecoder,
341	  probs : Vp8AdaptiveProbs,
342	  is_dc : Bool,
343	) -> Array[Int] {
344	  ignore(is_dc)	<-- UNCOVERED
345	  let coeffs = Array::make(16, 0)
346	  let zigzag = vp8_zigzag_4x4()
347	  let mut eob = false // end of block
348	  for i in 0..<16 {
349	    if eob {	<-- UNCOVERED
350	      break
351	    }
352	    let pos = zigzag[i]
353	    // 使用自适应概率解析 base token
354	    let zero_prob = probs.get_zero_prob(i)	<-- UNCOVERED
355	    let is_zero = bd.read_bool(zero_prob) == 1
356	    if is_zero {
357	      probs.record_zero(i)	<-- UNCOVERED
358	      // 检查是否是 EOB（块结束）
359	      if i > 0 {
360	        let eob_prob = probs.get_eob_prob(i)	<-- UNCOVERED
361	        let is_eob = bd.read_bool(eob_prob) == 1
362	        if is_eob {
363	          probs.record_eob(i)	<-- UNCOVERED
364	          eob = true
365	        }
366	      }
367	      continue
368	    }
369	    // 非零系数：解析符号和值
370	    let one_prob = probs.get_one_prob(i)	<-- UNCOVERED
371	    let is_one = bd.read_bool(one_prob) == 1
372	    let mut value = 0
373	    if is_one {
374	      probs.record_one(i)	<-- UNCOVERED
375	      value = 1
376	    } else {
377	      // 解析额外位
378	      let extra_prob = probs.get_extra_prob(i)	<-- UNCOVERED
379	      probs.record_extra(i)
380	      let mut extra = 1
381	      let mut continue_read = true
382	      while continue_read {
383	        let read_more = bd.read_bool(extra_prob) == 1	<-- UNCOVERED
384	        if read_more {
385	          extra = (extra << 1) | bd.read_bool(128)	<-- UNCOVERED
386	          if extra > 2047 {
387	            continue_read = false	<-- UNCOVERED
388	          }
389	        } else {
390	          continue_read = false	<-- UNCOVERED
391	        }
392	      }
393	      value = extra + 1
394	    }
395	    // 解析符号（使用自适应符号概率）
396	    let sign = bd.read_bool(probs.prob_sign)	<-- UNCOVERED
397	    let is_positive = sign == 0
398	    probs.record_sign(is_positive)	<-- UNCOVERED
399	    if !is_positive {
400	      value = -value	<-- UNCOVERED
401	    }
402	    coeffs[pos] = value
403	  }
404	  // 更新自适应概率
405	  probs.update()	<-- UNCOVERED
406	  coeffs
407	}
