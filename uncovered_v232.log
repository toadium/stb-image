1711	fn vp8_interpolate_subpixel(
1712	  ref_plane : Array[Int],
1713	  base_x : Int,
1714	  base_y : Int,
1715	  mv_x_q4 : Int,
1716	  mv_y_q4 : Int,
1717	  width : Int,
1718	  height : Int,
1719	) -> Int {
1720	  // 整数部分和小数部分
1721	  let int_x = mv_x_q4 >> 2	<-- UNCOVERED
1722	  let frac_x = mv_x_q4 & 3
1723	  let int_y = mv_y_q4 >> 2
1724	  let frac_y = mv_y_q4 & 3
1725	
1726	  let px = base_x + int_x
1727	  let py = base_y + int_y
1728	
1729	  // 如果是整数像素，直接返回
1730	  if frac_x == 0 && frac_y == 0 {
1731	    return vp8_get_ref_pixel(ref_plane, px, py, width, height)	<-- UNCOVERED
1732	  }
1733	
1734	  // 半像素插值（使用 6 抽头滤波器）
1735	  // 先进行水平插值得到半像素
1736	  let h_samples : Array[Int] = Array::make(6, 0)	<-- UNCOVERED
1737	  for i in 0..<6 {
1738	    h_samples[i] = vp8_get_ref_pixel(ref_plane, px - 2 + i, py, width, height)	<-- UNCOVERED
1739	  }
1740	  let half_x = if frac_x >= 2 {
1741	    vp8_interpolate_6tap(	<-- UNCOVERED
1742	      h_samples[0],
1743	      h_samples[1],
1744	      h_samples[2],
1745	      h_samples[3],
1746	      h_samples[4],
1747	      h_samples[5],
1748	    )
1749	  } else {
1750	    h_samples[2]	<-- UNCOVERED
1751	  }
1752	
1753	  // 进行垂直插值得到半像素
1754	  let v_samples : Array[Int] = Array::make(6, 0)	<-- UNCOVERED
1755	  for i in 0..<6 {
1756	    v_samples[i] = vp8_get_ref_pixel(ref_plane, px, py - 2 + i, width, height)	<-- UNCOVERED
1757	  }
1758	  let half_y = if frac_y >= 2 {
1759	    vp8_interpolate_6tap(	<-- UNCOVERED
1760	      v_samples[0],
1761	      v_samples[1],
1762	      v_samples[2],
1763	      v_samples[3],
1764	      v_samples[4],
1765	      v_samples[5],
1766	    )
1767	  } else {
1768	    v_samples[2]	<-- UNCOVERED
1769	  }
1770	
1771	  // 双线性插值（四分之一像素）
1772	  if frac_x == 0 {
1773	    // 只有垂直偏移
1774	    let t = frac_y	<-- UNCOVERED
1775	    return (half_x * (4 - t) + half_y * t + 2) >> 2
1776	  }
1777	  if frac_y == 0 {
1778	    // 只有水平偏移
1779	    let t = frac_x	<-- UNCOVERED
1780	    return (half_y * (4 - t) + half_x * t + 2) >> 2
1781	  }
1782	  // 双向偏移：使用四个角的双线性插值
1783	  let h00 = vp8_get_ref_pixel(ref_plane, px, py, width, height)	<-- UNCOVERED
1784	  let h10 = half_x
1785	  let h01 = half_y
1786	  // 计算对角半像素（先水平后垂直，或先垂直后水平，取平均）
1787	  let diag_samples_h : Array[Int] = Array::make(6, 0)	<-- UNCOVERED
1788	  for i in 0..<6 {
1789	    diag_samples_h[i] = vp8_get_ref_pixel(	<-- UNCOVERED
1790	      ref_plane,
1791	      px - 2 + i,
1792	      py + 1,
1793	      width,
1794	      height,
1795	    )
1796	  }
1797	  let h11 = vp8_interpolate_6tap(	<-- UNCOVERED
1798	    diag_samples_h[0],
1799	    diag_samples_h[1],
1800	    diag_samples_h[2],
1801	    diag_samples_h[3],
1802	    diag_samples_h[4],
1803	    diag_samples_h[5],
1804	  )
1805	
1806	  let tx = frac_x
1807	  let ty = frac_y
1808	  let a = h00 * (4 - tx) * (4 - ty)
1809	  let b = h10 * tx * (4 - ty)
1810	  let c = h01 * (4 - tx) * ty
1811	  let d = h11 * tx * ty
1812	  (a + b + c + d + 8) >> 4
1813	}
