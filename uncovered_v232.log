540	fn vp8_enc_segment_params_new(
541	  y_plane : Array[Int],
542	  width : Int,
543	  height : Int,
544	  base_quant : Int,
545	) -> Vp8EncSegmentParams {
546	  ignore(base_quant)	<-- UNCOVERED
547	  let mb_w = (width + 15) / 16
548	  let mb_h = (height + 15) / 16
549	  let total_mbs = mb_w * mb_h
550	  let segment_id_map : Array[Int] = Array::make(total_mbs, 0)	<-- UNCOVERED
551	  // 计算每个宏块的复杂度（方差）
552	  let complexities : Array[Int] = Array::make(total_mbs, 0)	<-- UNCOVERED
553	  for mb_y in 0..<mb_h {
554	    for mb_x in 0..<mb_w {	<-- UNCOVERED
555	      let mut sum = 0
556	      let mut sum_sq = 0
557	      let mut count = 0
558	      for y in 0..<16 {
559	        for x in 0..<16 {	<-- UNCOVERED
560	          let px = mb_x * 16 + x
561	          let py = mb_y * 16 + y
562	          if px < width && py < height {
563	            let val = y_plane[py * width + px]	<-- UNCOVERED
564	            sum += val
565	            sum_sq += val * val
566	            count += 1
567	          }
568	        }
569	      }
570	      if count > 0 {
571	        let mean = sum / count	<-- UNCOVERED
572	        let variance = sum_sq / count - mean * mean
573	        complexities[mb_y * mb_w + mb_x] = variance
574	      }
575	    }
576	  }
577	  // 根据复杂度分配 segment（0=低复杂度, 3=高复杂度）
578	  let mut max_complexity = 1
579	  for c in complexities {
580	    if c > max_complexity {	<-- UNCOVERED
581	      max_complexity = c
582	    }
583	  }
584	  for i in 0..<total_mbs {
585	    let ratio = complexities[i] * 4 / max_complexity	<-- UNCOVERED
586	    segment_id_map[i] = ratio.clamp(min=0, max=3)
587	  }
588	  // 量化器增量（高复杂度 segment 使用更小的量化增量，即更高质量）
589	  let quantizer_delta = [0, -4, -8, -12]
590	  // 滤波级别增量（高复杂度 segment 使用更强的滤波）
591	  let filter_level_delta = [0, 2, 4, 6]
592	  Vp8EncSegmentParams::{
593	    segmentation_enabled: true,
594	    quantizer_delta,
595	    _filter_level_delta: filter_level_delta,
596	    segment_id_map,
597	  }
598	}
