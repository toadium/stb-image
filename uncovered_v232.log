313	        count += 1
314	      }
315	    }
316	    projection[x] = count
317	  }
318	  // 检测分割点（投影局部最小值）
319	  let split_points : Array[Int] = []
320	  for x in 2..<(w - 2) {
321	    if projection[x] < projection[x - 1] &&
322	      projection[x] < projection[x + 1] &&
323	      projection[x] < h / 10 {
324	      split_points.push(x)	<-- UNCOVERED
325	    }
326	  }
327	  // 基于分割点提取字符区域
328	  let regions : Array[(Int, Int, Int, Int)] = []
329	  let mut prev_x = 0
330	  for split_x in split_points {
331	    let char_w = split_x - prev_x	<-- UNCOVERED
332	    if char_w >= min_char_width && char_w <= max_char_width {
333	      // 找到字符的上下边界
334	      let mut min_y = h	<-- UNCOVERED
335	      let mut max_y = 0
336	      for x in prev_x..<split_x {
337	        for y in 0..<h {	<-- UNCOVERED
338	          if data[y * w + x].to_int() > 128 {
339	            if y < min_y {
340	              min_y = y
341	            }
342	            if y > max_y {
343	              max_y = y	<-- UNCOVERED
344	            }
345	          }
346	        }
347	      }
348	      if max_y > min_y {
349	        regions.push((prev_x, min_y, char_w, max_y - min_y + 1))	<-- UNCOVERED
350	      }
351	    }
352	    prev_x = split_x
353	  }
354	  // 处理最后一个字符
355	  let char_w = w - prev_x
356	  if char_w >= min_char_width && char_w <= max_char_width {
357	    let mut min_y = h
358	    let mut max_y = 0
359	    for x in prev_x..<w {
360	      for y in 0..<h {
361	        if data[y * w + x].to_int() > 128 {
362	          if y < min_y {
363	            min_y = y
364	          }
365	          if y > max_y {
366	            max_y = y
367	          }
368	        }
369	      }
370	    }
371	    if max_y > min_y {
372	      regions.push((prev_x, min_y, char_w, max_y - min_y + 1))
373	    }
374	  }
375	  regions
376	}
