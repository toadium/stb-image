347	pub fn update_tracking(
348	  obj : TrackedObject,
349	  frame : @types.Image,
350	) -> TrackedObject {
351	  let w = frame.width
352	  let h = frame.height
353	  let search_radius = 20
354	
355	  let mut best_x = obj.x
356	  let mut best_y = obj.y
357	  let mut best_score = -1.0
358	
359	  // 在目标周围搜索最佳匹配
360	  for dy in -search_radius..<(search_radius + 1) {
361	    for dx in -search_radius..<(search_radius + 1) {
362	      let new_x = obj.x + dx
363	      let new_y = obj.y + dy
