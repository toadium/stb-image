409	      } else if result > 255.0 {
410	        255.0	<-- UNCOVERED
411	      } else {
412	        result
413	      }
414	      out.push(clamped.to_int().to_byte())
415	    }
416	  }
417	
418	  @types.Image::{
419	    width: w,
420	    height: h,
421	    channels: img.channels,
422	    data: Bytes::from_array(out),
