689	fn vp8_idct_4x4(block : Array[Int]) -> Array[Int] {
690	  let result = Array::make(16, 0)	<-- UNCOVERED
691	  // 行变换（一维 IDCT）
692	  for i in 0..<4 {
693	    let a0 = block[i * 4]	<-- UNCOVERED
694	    let a1 = block[i * 4 + 1]
695	    let a2 = block[i * 4 + 2]
696	    let a3 = block[i * 4 + 3]
697	    // VP8 一维 IDCT（使用 c=85627, c*sqrt(2)=121095）
698	    let b0 = a0 * 85627 + a2 * 85627
699	    let b1 = a0 * 85627 - a2 * 85627
700	    let b2 = a1 * 53527 - a3 * 22109
701	    let b3 = a1 * 22109 + a3 * 53527
702	    result[i * 4] = (b0 + b3) >> 17
703	    result[i * 4 + 1] = (b1 + b2) >> 17
704	    result[i * 4 + 2] = (b1 - b2) >> 17
705	    result[i * 4 + 3] = (b0 - b3) >> 17
706	  }
707	  // 列变换（一维 IDCT）
708	  let temp = Array::make(16, 0)	<-- UNCOVERED
709	  for i in 0..<16 {
710	    temp[i] = result[i]	<-- UNCOVERED
711	  }
712	  for j in 0..<4 {
713	    let a0 = temp[j]	<-- UNCOVERED
714	    let a1 = temp[4 + j]
715	    let a2 = temp[8 + j]
716	    let a3 = temp[12 + j]
717	    let b0 = a0 * 85627 + a2 * 85627
718	    let b1 = a0 * 85627 - a2 * 85627
719	    let b2 = a1 * 53527 - a3 * 22109
720	    let b3 = a1 * 22109 + a3 * 53527
721	    result[j] = (b0 + b3) >> 17
722	    result[4 + j] = (b1 + b2) >> 17
723	    result[8 + j] = (b1 - b2) >> 17
724	    result[12 + j] = (b0 - b3) >> 17
725	  }
726	  result
727	}
