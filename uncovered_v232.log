 62	fn projection_variance_at_angle(
 63	  data : Bytes,
 64	  width : Int,
 65	  height : Int,
 66	  angle_deg : Double,
 67	) -> Double {
 68	  let angle_rad = angle_deg * 3.141592653589793 / 180.0
 69	  let cos_a = @math.cos(angle_rad)
 70	  let sin_a = @math.sin(angle_rad)
 71	  // 计算旋转后的图像尺寸
 72	  let new_h = (height.to_double() * cos_a.abs() +
 73	    width.to_double() * sin_a.abs()).to_int() +
 74	    1
 75	  // 计算水平投影
 76	  let projection : Array[Int] = Array::make(new_h, 0)
 77	  for y in 0..<height {
 78	    for x in 0..<width {
 79	      if data[y * width + x].to_int() < 128 {
 80	        // 黑色像素（文字）
 81	        let new_y = ((x.to_double() - width.to_double() / 2.0) * sin_a +
 82	        (y.to_double() - height.to_double() / 2.0) * cos_a +
 83	        new_h.to_double() / 2.0).to_int()
 84	        if new_y >= 0 && new_y < new_h {
 85	          projection[new_y] += 1
 86	        }
 87	      }
 88	    }
 89	  }
 90	  // 计算投影的方差
 91	  let mut sum = 0
 92	  let mut sum_sq = 0
 93	  let mut count = 0
 94	  for i in 0..<new_h {
 95	    sum += projection[i]
 96	    sum_sq += projection[i] * projection[i]
 97	    count += 1
 98	  }
 99	  if count == 0 {
100	    return 0.0	<-- UNCOVERED
101	  }
102	  let mean = sum.to_double() / count.to_double()
103	  let variance = sum_sq.to_double() / count.to_double() - mean * mean
104	  variance
105	}
