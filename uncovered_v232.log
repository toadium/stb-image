777	fn vp8_build_frame_header(
778	  width : Int,
779	  height : Int,
780	  first_part_size : Int,
781	) -> Bytes {
782	  let result : Array[Byte] = []	<-- UNCOVERED
783	  // 3 bytes: frame tag
784	  let tag = (0 << 0) | (0 << 1) | (1 << 4) | (first_part_size << 5)
785	  result.push((tag & 0xFF).to_byte())	<-- UNCOVERED
786	  result.push(((tag >> 8) & 0xFF).to_byte())
787	  result.push(((tag >> 16) & 0xFF).to_byte())
788	  // 3 bytes: start code
789	  result.push(b'\x9D')	<-- UNCOVERED
790	  result.push(b'\x01')
791	  result.push(b'\x2A')
792	  // 2 bytes: width + horizontal scale
793	  result.push((width & 0xFF).to_byte())	<-- UNCOVERED
