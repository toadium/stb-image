255	pub fn analyze_dct_coefficients(img : @types.Image) -> DctCoefficientResult {
256	  let w = img.width
257	  let h = img.height
258	
259	  // 简化 DCT：计算 8x8 块的 DCT 系数统计
260	  let block_size = 8
261	  let num_blocks_x = w / block_size
262	  let num_blocks_y = h / block_size
263	  let num_blocks = num_blocks_x * num_blocks_y
264	
265	  let mut high_freq_count = 0
266	  let mut zero_count = 0
267	  let mut total_coeffs = 0
268	  let mut blockiness = 0.0
269	
270	  let distribution : Array[Double] = []
271	  let num_bins = 10
272	  for _ in 0..<num_bins {
273	    distribution.push(0.0)
274	  }
275	
276	  for by in 0..<num_blocks_y {
277	    for bx in 0..<num_blocks_x {
278	      // 计算 8x8 块的简化 DCT
279	      let mut dc = 0.0
280	      let mut ac_energy = 0.0
281	      for j in 0..<block_size {
282	        for i in 0..<block_size {
283	          let idx = (by * block_size + j) * w + (bx * block_size + i)
284	          let val = img.data[idx].to_double()
285	          dc += val
286	          if i > 0 || j > 0 {
287	            ac_energy += val * val
288	          }
289	        }
290	      }
291	      dc /= (block_size * block_size).to_double()
292	
293	      // 块边界不连续性
294	      if bx > 0 {
295	        let mut border_diff = 0.0
296	        for j in 0..<block_size {
297	          let idx_left = (by * block_size + j) * w + (bx * block_size - 1)
298	          let idx_right = (by * block_size + j) * w + bx * block_size
299	          border_diff += (img.data[idx_left].to_double() -
300	          img.data[idx_right].to_double()).abs()
301	        }
302	        blockiness += border_diff / block_size.to_double()
303	      }
304	
305	      total_coeffs += block_size * block_size
306	      if ac_energy < 100.0 {
307	        zero_count += block_size * block_size - 1	<-- UNCOVERED
308	      }
309	      if ac_energy > 1000.0 {
310	        high_freq_count += block_size * block_size - 1
311	      }
312	
313	      // 分布统计
314	      let bin = (dc.to_int() * num_bins / 256).clamp(min=0, max=num_bins - 1)
315	      distribution[bin] += 1.0
316	    }
317	  }
318	
319	  if num_blocks > 0 {
320	    blockiness /= num_blocks.to_double()
321	  }
322	
323	  let high_freq_ratio = if total_coeffs > 0 {
324	    high_freq_count.to_double() / total_coeffs.to_double()
325	  } else {
326	    0.0	<-- UNCOVERED
327	  }
328	  let zero_ratio = if total_coeffs > 0 {
329	    zero_count.to_double() / total_coeffs.to_double()
330	  } else {
331	    0.0	<-- UNCOVERED
332	  }
333	
334	  // 归一化分布
335	  if num_blocks > 0 {
336	    for i in 0..<num_bins {
337	      distribution[i] /= num_blocks.to_double()
338	    }
339	  }
340	
341	  // 双 JPEG 指示：DCT 系数分布有周期性峰值
342	  let mut double_jpeg_indicator = 0.0
343	  for i in 1..<(num_bins - 1) {
344	    if distribution[i] > distribution[i - 1] &&
345	      distribution[i] > distribution[i + 1] {
346	      double_jpeg_indicator += 1.0
347	    }
348	  }
349	  double_jpeg_indicator /= num_bins.to_double()
350	
351	  DctCoefficientResult::{
