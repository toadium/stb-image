120	      let edge_factor = if tx < 2 || tx >= size - 2 || y < 2 || y >= size - 2 {
121	        0.6
122	      } else {
123	        1.0
124	      }
125	      let threshold = (30.0 + center_factor * 25.0 + edge_factor * 10.0).to_int()
126	      if combined < threshold && tx >= 0 && tx < size {
127	        features[y * size + x] = 1.0
128	      }
129	    }
130	  }
131	  features
132	}
