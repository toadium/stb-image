 951	    // 垂直预测为主，向右下方倾斜
 952	    // P[y][x] = (above[x] + above[x+1] + left[y] + 1) >> 2
 953	    I4x4RightUpPred =>
 954	      for y in 0..<4 {	<-- UNCOVERED
