146	    }
147	  }
148	  // 按响应值排序（降序）
149	  candidates.sort_by(fn(a, b) { b.response.compare(a.response) })
150	  // 距离过滤
151	  let result : Array[CornerPoint] = []
152	  for c in candidates {
153	    let mut ok = true
154	    for r in result {
155	      let dx = c.x - r.x
156	      let dy = c.y - r.y
157	      if dx * dx + dy * dy < min_distance * min_distance {
158	        ok = false
159	        break
160	      }
161	    }
162	    if ok {
163	      result.push(c)
164	    }
165	  }
166	  result
