112	      let h3 = ((seed << 2) ^ (tx << 1) ^ y) % 100
113	      let combined = (h1 * 4 + h2 * 3 + h3 * 2) / 9
114	      // 中心权重（手写体通常居中但有偏移）
115	      let center_dist = ((tx - center_x) * (tx - center_x) +
