 78	      ix[idx] = (
 79	          gray[(y - 1) * w + (x + 1)] +
 80	          2.0F * gray[y * w + (x + 1)] +
 81	          gray[(y + 1) * w + (x + 1)] -
 82	          gray[(y - 1) * w + (x - 1)] -
 83	          2.0F * gray[y * w + (x - 1)] -
 84	          gray[(y + 1) * w + (x - 1)]
 85	        ) /
 86	        8.0F
 87	      iy[idx] = (
 88	          gray[(y + 1) * w + (x - 1)] +
 89	          2.0F * gray[(y + 1) * w + x] +
 90	          gray[(y + 1) * w + (x + 1)] -
 91	          gray[(y - 1) * w + (x - 1)] -
