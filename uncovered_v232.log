457	fn vp8_encode_block_tokens(
458	  enc : Vp8BoolEncoder,
459	  coeffs : Array[Int],
460	  is_dc : Bool,
461	) -> Unit {
462	  ignore(is_dc)	<-- UNCOVERED
463	  // zig-zag 顺序
464	  let zigzag = [0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15]
465	  let mut eob = false
466	  for i in 0..<16 {
467	    if eob {	<-- UNCOVERED
468	      break
469	    }
470	    let pos = zigzag[i]
471	    let c = coeffs[pos]
472	    if c == 0 {
473	      // 零系数
474	      if i > 0 {	<-- UNCOVERED
475	        // 检查是否是 EOB
476	        let mut has_nonzero = false	<-- UNCOVERED
477	        for j in (i + 1)..<16 {
478	          if coeffs[zigzag[j]] != 0 {	<-- UNCOVERED
479	            has_nonzero = true
480	            break
481	          }
482	        }
483	        if !has_nonzero {
484	          enc.encode_bool(1, 100) // EOB	<-- UNCOVERED
485	          eob = true
486	        } else {
487	          enc.encode_bool(0, 100) // 不是 EOB	<-- UNCOVERED
488	        }
489	      }
490	      enc.encode_bool(1, 200) // 零系数	<-- UNCOVERED
491	    } else {
492	      // 非零系数
493	      if i > 0 {	<-- UNCOVERED
494	        enc.encode_bool(0, 100) // 不是 EOB
495	      }
496	      enc.encode_bool(0, 200) // 非零系数	<-- UNCOVERED
497	      // 编码值（简化：直接编码绝对值和符号）
498	      let abs_val = c.abs()	<-- UNCOVERED
499	      if abs_val == 1 {
500	        enc.encode_bool(1, 170) // 值为 1	<-- UNCOVERED
501	      } else {
502	        enc.encode_bool(0, 170) // 值大于 1	<-- UNCOVERED
503	        // 编码额外位（简化）
504	        let mut extra = abs_val - 1
505	        while extra > 0 {
506	          enc.encode_bit(1) // 继续	<-- UNCOVERED
507	          extra = extra >> 1
508	        }
509	        enc.encode_bit(0) // 结束	<-- UNCOVERED
510	      }
511	      // 符号位
512	      if c < 0 {
513	        enc.encode_bit(1)	<-- UNCOVERED
514	      } else {
515	        enc.encode_bit(0)	<-- UNCOVERED
516	      }
517	    }
518	  }
519	  if !eob {	<-- UNCOVERED
520	    // 没有 EOB，所有系数都非零
521	  }
522	}
