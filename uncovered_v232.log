471	      let gy = image.data[idx + w] - image.data[idx - w]
472	      sharpness += (gx * gx + gy * gy).sqrt()
473	    }
474	  }
475	  sharpness /= total.to_double()
476	
477	  let noise_level = std
478	  let cnr = snr * 0.8
