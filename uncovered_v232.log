604	  mb_x : Int,
605	  mb_y : Int,
606	  mb_w : Int,
607	  base_quant : Int,
608	) -> Int {
609	  if !segment.segmentation_enabled {	<-- UNCOVERED
610	    return base_quant
611	  }
612	  let idx = mb_y * mb_w + mb_x
613	  if idx >= 0 && idx < segment.segment_id_map.length() {	<-- UNCOVERED
614	    let seg_id = segment.segment_id_map[idx]
615	    let delta = segment.quantizer_delta[seg_id]
616	    return (base_quant + delta).clamp(min=1, max=127)	<-- UNCOVERED
617	  }
618	  base_quant
619	}
