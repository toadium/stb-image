253	pub fn sharpen_image(img : @types.Image, strength : Double) -> @types.Image {
254	  let w = img.width
255	  let h = img.height
256	  let out : Array[Byte] = []
257	
258	  // 简化的锐化：中心加权
259	  for y in 0..<h {
260	    for x in 0..<w {
261	      let center = img.data[y * w + x].to_double()
262	      let mut sum = 0.0
263	      let mut count = 0
264	      for dy in -1..<2 {
265	        for dx in -1..<2 {
266	          if dx == 0 && dy == 0 {
267	            continue
268	          }
269	          let nx = x + dx
270	          let ny = y + dy
271	          if nx >= 0 && nx < w && ny >= 0 && ny < h {
272	            sum += img.data[ny * w + nx].to_double()
273	            count += 1
274	          }
275	        }
276	      }
277	      let avg = if count > 0 { sum / count.to_double() } else { center }
278	      let sharpened = center + strength * (center - avg)
279	      let clamped = if sharpened < 0.0 {
280	        0.0
281	      } else if sharpened > 255.0 {
282	        255.0	<-- UNCOVERED
283	      } else {
284	        sharpened
285	      }
286	      out.push(clamped.to_int().to_byte())
287	    }
288	  }
289	
290	  @types.Image::{
291	    width: w,
292	    height: h,
293	    channels: img.channels,
294	    data: Bytes::from_array(out),
295	  }
296	}
