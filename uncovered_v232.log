672	    )
673	  }
674	  let w = img.width
675	  let h = img.height
676	  let total = w * h
677	
678	  // 计算像素值分布的熵
679	  let histogram : Array[Int] = []
680	  for _ in 0..<256 {
681	    histogram.push(0)
682	  }
683	  for i in 0..<total {
684	    histogram[img.data[i].to_int()] += 1
685	  }
