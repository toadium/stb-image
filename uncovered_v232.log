654	pub fn calculate_psnr(
655	  original : @types.Image,
656	  encrypted : @types.Image,
657	) -> Double raise @types.LoadError {
658	  // 输入验证
659	  if original.width <= 0 || original.height <= 0 {
660	    raise @types.LoadError::DecodeFailed(
661	      "calculate_psnr: 图像尺寸必须大于0",
662	    )
663	  }
664	  if original.channels < 1 || original.channels > 4 {
665	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
666	      "calculate_psnr: 通道数必须在1-4之间",
667	    )
668	  }
669	  let expected_size = original.width * original.height * original.channels
670	  if original.data.length() != expected_size {
671	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
672	      "calculate_psnr: 数据大小不匹配",
673	    )
674	  }
675	  if encrypted.width <= 0 || encrypted.height <= 0 {
676	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
677	      "calculate_psnr: 图像尺寸必须大于0",
678	    )
679	  }
680	  if encrypted.channels < 1 || encrypted.channels > 4 {
681	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
682	      "calculate_psnr: 通道数必须在1-4之间",
683	    )
684	  }
685	  let expected_size2 = encrypted.width * encrypted.height * encrypted.channels
686	  if encrypted.data.length() != expected_size2 {
687	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
688	      "calculate_psnr: 数据大小不匹配",
689	    )
690	  }
691	  let w = original.width
692	  let h = original.height
693	  let total = w * h
694	  let mut mse = 0.0
695	
696	  for i in 0..<total {
697	    let p1 = original.data[i].to_double()
698	    let p2 = encrypted.data[i].to_double()
699	    let diff = p1 - p2
700	    mse += diff * diff
701	  }
702	  mse /= total.to_double()
703	
704	  if mse > 0.0 {
705	    10.0 * (255.0 * 255.0 / mse) * 0.1
706	  } else {
707	    100.0
708	  }
709	}
