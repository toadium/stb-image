349	pub fn embed_watermark_lsb(
350	  img : @types.Image,
351	  watermark : Array[Byte],
352	  strength : Int,
353	) -> (@types.Image, WatermarkInfo) raise @types.LoadError {
354	  // 输入验证
355	  if img.width <= 0 || img.height <= 0 {
356	    raise @types.LoadError::DecodeFailed(
357	      "embed_watermark_lsb: 图像尺寸必须大于0",
358	    )
359	  }
360	  if img.channels < 1 || img.channels > 4 {
361	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
362	      "embed_watermark_lsb: 通道数必须在1-4之间",
363	    )
364	  }
365	  let expected_size = img.width * img.height * img.channels
366	  if img.data.length() != expected_size {
367	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
368	      "embed_watermark_lsb: 数据大小不匹配",
369	    )
370	  }
371	  if watermark.length() == 0 {
372	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
373	      "embed_watermark_lsb: 水印数据不能为空",
374	    )
375	  }
376	  let w = img.width
377	  let h = img.height
378	  let total = w * h
379	  let watermarked : Array[Byte] = []
380	  let wm_len = watermark.length()
381	
382	  for i in 0..<total {
383	    let pixel = img.data[i].to_int()
384	    if i < wm_len * 8 {
385	      let byte_idx = i / 8
386	      let bit_idx = 7 - i % 8
387	      let wm_byte = watermark[byte_idx].to_int()
388	      let wm_bit = (wm_byte >> bit_idx) & 1
389	      let mask = 255 - (1 << strength)
390	      let new_pixel = (pixel & mask) | (wm_bit << strength)
391	      watermarked.push(new_pixel.to_byte())
392	    } else {
393	      watermarked.push(img.data[i])
394	    }
395	  }
396	
397	  let info = WatermarkInfo::{
398	    watermark_type: WatermarkType::Invisible_LSB,
399	    watermark_data: watermark,
400	    watermark_width: 0,
401	    watermark_height: 0,
402	    strength: strength.to_double(),
403	    embedded: true,
404	    embedding_position: "LSB",
405	    key: "lsb_key",
406	  }
407	
408	  (
409	    @types.Image::{
410	      width: w,
411	      height: h,
412	      channels: img.channels,
413	      data: Bytes::from_array(watermarked),
414	    },
415	    info,
416	  )
417	}
