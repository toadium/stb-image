457	    sum += pixel
458	    sum_sq += pixel * pixel
459	  }
460	  let mean = sum / total.to_double()
461	  let variance = sum_sq / total.to_double() - mean * mean
462	  let std = if variance > 0.0 { variance.sqrt() } else { 1.0 }
463	  let snr = if std > 0.0 { mean / std } else { 0.0 }
464	
465	  // 计算清晰度（基于梯度）
