625	fn vp8_encoder_loop_filter(
626	  y_plane : Array[Int],
627	  width : Int,
628	  height : Int,
629	  filter_level : Int,
630	) -> Unit {
631	  if filter_level == 0 {	<-- UNCOVERED
632	    return
633	  }
634	  let mb_w = (width + 15) / 16
635	  let mb_h = (height + 15) / 16
636	  // 宏块边界垂直滤波
637	  for mb_y in 0..<mb_h {
638	    for mb_x in 1..<mb_w {	<-- UNCOVERED
639	      for y in 0..<16 {
640	        let py = mb_y * 16 + y
641	        if py >= height {
642	          break	<-- UNCOVERED
643	        }
644	        let px = mb_x * 16
645	        if px > 0 && px < width {
646	          let idx = py * width + px	<-- UNCOVERED
647	          let p1 = y_plane[idx - 1]
648	          let p0 = y_plane[idx]
649	          let diff = p0 - p1
650	          if diff.abs() < filter_level {	<-- UNCOVERED
651	            let adj = diff / 2
652	            y_plane[idx - 1] = p1 + adj
653	            y_plane[idx] = p0 - adj
654	          }
655	        }
656	      }
657	    }
658	  }
659	  // 宏块边界水平滤波
660	  for mb_y in 1..<mb_h {
661	    for mb_x in 0..<mb_w {	<-- UNCOVERED
662	      for x in 0..<16 {
663	        let px = mb_x * 16 + x
664	        if px >= width {
665	          break	<-- UNCOVERED
666	        }
667	        let py = mb_y * 16
668	        if py > 0 && py < height {
669	          let idx = py * width + px	<-- UNCOVERED
670	          let p1 = y_plane[idx - width]
671	          let p0 = y_plane[idx]
672	          let diff = p0 - p1
673	          if diff.abs() < filter_level {	<-- UNCOVERED
674	            let adj = diff / 2
675	            y_plane[idx - width] = p1 + adj
676	            y_plane[idx] = p0 - adj
677	          }
678	        }
679	      }
680	    }
681	  }
682	}
