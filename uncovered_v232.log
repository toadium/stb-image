449	pub fn analyze_color_quantization(
450	  img : @types.Image,
451	) -> ColorQuantizationResult raise @types.LoadError {
452	  // 输入验证
453	  if img.width <= 0 || img.height <= 0 {
454	    raise @types.LoadError::DecodeFailed(
455	      "analyze_color_quantization: 图像尺寸必须大于0",
456	    )
457	  }
458	  if img.channels < 1 || img.channels > 4 {
459	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
460	      "analyze_color_quantization: 通道数必须在1-4之间",
461	    )
462	  }
463	  let expected_size = img.width * img.height * img.channels
464	  if img.data.length() != expected_size {
465	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
466	      "analyze_color_quantization: 数据大小不匹配",
467	    )
468	  }
469	  let w = img.width
470	  let h = img.height
471	  let total = w * h
472	
473	  // 统计唯一颜色数量（量化到 64 级）
474	  let color_histogram : Array[Int] = []
475	  for _ in 0..<64 {
476	    color_histogram.push(0)
477	  }
478	  for i in 0..<total {
479	    let bin = img.data[i].to_int() * 64 / 256
480	    color_histogram[bin] += 1
481	  }
482	
483	  let mut unique_colors = 0
484	  for i in 0..<64 {
485	    if color_histogram[i] > 0 {
486	      unique_colors += 1
487	    }
488	  }
489	
490	  // 顶部颜色比例
491	  let sorted_colors : Array[Int] = []
492	  for i in 0..<64 {
493	    sorted_colors.push(color_histogram[i])
494	  }
495	  // 冒泡排序
496	  for i in 0..<64 {
497	    for j in 0..<(64 - i - 1) {
498	      if sorted_colors[j] < sorted_colors[j + 1] {
499	        let temp = sorted_colors[j]
500	        sorted_colors[j] = sorted_colors[j + 1]
501	        sorted_colors[j + 1] = temp
502	      }
503	    }
504	  }
505	
506	  let top_color_ratio = if total > 0 {
507	    sorted_colors[0].to_double() / total.to_double()
508	  } else {
509	    0.0	<-- UNCOVERED
510	  }
511	  let mut top_10_sum = 0
512	  for i in 0..<10 {
513	    top_10_sum += sorted_colors[i]
514	  }
515	  let top_10_ratio = if total > 0 {
516	    top_10_sum.to_double() / total.to_double()
517	  } else {
518	    0.0	<-- UNCOVERED
519	  }
520	
521	  // 颜色量化级别：唯一颜色越少，量化越严重（UI 界面特征）
522	  let quantization_level = 1.0 - unique_colors.to_double() / 64.0
523	
524	  // 颜色调色板大小（估计）
525	  let palette_size = unique_colors
526	
527	  // 颜色量化指示值：颜色越集中，越可能是屏幕截图（物理生成）
528	  let color_quantization_indicator = if top_10_ratio > 0.8 {
529	    0.85
530	  } else if top_10_ratio > 0.65 {
531	    0.65	<-- UNCOVERED
532	  } else if top_10_ratio > 0.5 {
533	    0.45	<-- UNCOVERED
534	  } else {
535	    0.25
536	  }
537	
538	  ColorQuantizationResult::{
539	    unique_color_count: unique_colors,
540	    color_quantization_level: quantization_level,
541	    top_color_ratio,
542	    top_10_color_ratio: top_10_ratio,
543	    color_palette_size: palette_size,
544	    color_quantization_indicator,
545	  }
546	}
