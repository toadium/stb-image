363	pub fn detect_clone_regions(
364	  img : @types.Image,
365	  block_size : Int,
366	  threshold : Double,
367	) -> CloneDetectionResult raise @types.LoadError {
368	  let w = img.width
369	  let h = img.height
370	
371	  if block_size < 2 || block_size > 16 {
372	    raise @types.LoadError::DecodeFailed("block_size must be 2..16")
373	  }
374	
375	  let num_blocks_x = w - block_size + 1
376	  let num_blocks_y = h - block_size + 1
377	
378	  // 提取块特征（简化：均值+方差）
379	  let block_features : Array[(Double, Double, Int, Int)] = []
380	  for by in 0..<num_blocks_y {
381	    for bx in 0..<num_blocks_x {
382	      let mut mean = 0.0
383	      let mut sq_sum = 0.0
384	      let count = block_size * block_size
385	      for j in 0..<block_size {
386	        for i in 0..<block_size {
387	          let idx = (by + j) * w + (bx + i)
388	          let val = img.data[idx].to_double()
389	          mean += val
390	          sq_sum += val * val
391	        }
392	      }
393	      mean /= count.to_double()
394	      let variance = sq_sum / count.to_double() - mean * mean
395	      block_features.push((mean, variance, bx, by))
396	    }
397	  }
398	
399	  // 比较块特征，找相似块
400	  let clone_regions : Array[(Int, Int, Int, Int)] = []
401	  let mut clone_count = 0
402	  let mut total_similarity = 0.0
403	  let mut comparison_count = 0
404	
405	  let n = block_features.length()
406	  for i in 0..<n {
407	    for j in 0..<n {
408	      if i >= j {
409	        continue
410	      }
411	      let (m1, v1, x1, y1) = block_features[i]
412	      let (m2, v2, x2, y2) = block_features[j]
413	      // 跳过相邻块
414	      let dist = (x1 - x2).abs() + (y1 - y2).abs()
415	      if dist < block_size * 2 {
416	        continue
417	      }
418	      let mean_diff = (m1 - m2).abs()
419	      let var_diff = (v1 - v2).abs()
420	      let similarity = 1.0 / (1.0 + mean_diff / 10.0 + var_diff / 100.0)
421	      total_similarity += similarity
422	      comparison_count += 1
423	      if similarity > threshold && clone_count < 20 {
424	        clone_regions.push((x1, y1, x2, y2))
425	        clone_count += 1
426	      }
427	    }
428	  }
429	
430	  let avg_similarity = if comparison_count > 0 {
431	    total_similarity / comparison_count.to_double()
432	  } else {
433	    0.0	<-- UNCOVERED
434	  }
435	
436	  CloneDetectionResult::{
437	    clone_region_count: clone_count,
438	    clone_regions,
439	    clone_similarity: avg_similarity,
440	    has_clone: clone_count > 0,
441	  }
442	}
