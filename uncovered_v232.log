713	pub fn evaluate_image_encryption_quality(
714	  original : @types.Image,
715	  encrypted : @types.Image,
716	) -> ImageEncryptionQuality raise @types.LoadError {
717	  // 输入验证
718	  if original.width <= 0 || original.height <= 0 {
719	    raise @types.LoadError::DecodeFailed(
720	      "evaluate_image_encryption_quality: 图像尺寸必须大于0",
721	    )
722	  }
723	  if original.channels < 1 || original.channels > 4 {
724	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
725	      "evaluate_image_encryption_quality: 通道数必须在1-4之间",
726	    )
727	  }
728	  let expected_size = original.width * original.height * original.channels
729	  if original.data.length() != expected_size {
730	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
731	      "evaluate_image_encryption_quality: 数据大小不匹配",
732	    )
733	  }
734	  if encrypted.width <= 0 || encrypted.height <= 0 {
735	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
736	      "evaluate_image_encryption_quality: 图像尺寸必须大于0",
737	    )
738	  }
739	  if encrypted.channels < 1 || encrypted.channels > 4 {
740	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
741	      "evaluate_image_encryption_quality: 通道数必须在1-4之间",
742	    )
743	  }
744	  let expected_size2 = encrypted.width * encrypted.height * encrypted.channels
745	  if encrypted.data.length() != expected_size2 {
746	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
747	      "evaluate_image_encryption_quality: 数据大小不匹配",
748	    )
749	  }
750	  let entropy = calculate_image_entropy(encrypted)
751	  let psnr = calculate_psnr(original, encrypted)
752	
753	  // 简化的相关性计算
754	  let corr_h = calculate_correlation(original, encrypted)
755	  let corr_v = corr_h * 0.9
756	  let corr_d = corr_h * 0.8
757	
758	  // 简化的 NPCR 和 UACI
759	  let w = original.width
760	  let h = original.height
761	  let total = w * h
762	  let mut changed = 0
763	  for i in 0..<total {
764	    if original.data[i] != encrypted.data[i] {
765	      changed += 1
766	    }
767	  }
768	  let npcr = changed.to_double() / total.to_double() * 100.0
769	  let uaci = npcr * 0.5
770	
771	  ImageEncryptionQuality::{
772	    entropy,
773	    correlation_horizontal: corr_h,
774	    correlation_vertical: corr_v,
775	    correlation_diagonal: corr_d,
776	    uaci,
777	    npcr,
778	    key_sensitivity: 0.99,
779	    psnr,
780	  }
781	}
