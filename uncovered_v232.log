709	pub fn intelligent_decision(
710	  basic_result : SourceVerificationResult,
711	  ui_result : UIDetectionResult,
712	  text_result : TextDetectionResult,
713	  geometry_result : GeometryAnalysisResult,
714	  color_result : ColorQuantizationResult,
715	  solid_indicator : Double,
716	  edge_dir_indicator : Double,
717	  pixel_dist_indicator : Double,
718	  config : EnhancedVerificationConfig,
719	) -> (ImageSourceType, Double, Double, Double, String) {
720	  // 增强特征的物理生成指示值（值越高越可能是物理生成）
721	  let enhanced_physical_score = ui_result.ui_indicator * 0.25 +
722	    text_result.text_indicator * 0.20 +
723	    geometry_result.geometry_indicator * 0.15 +
724	    color_result.color_quantization_indicator * 0.15 +
725	    solid_indicator * 0.10 +
726	    edge_dir_indicator * 0.08 +
727	    pixel_dist_indicator * 0.07
728	
729	  // 基础特征的 AI 生成指示值
730	  let basic_ai_score = basic_result.ai_probability
731	
732	  // 加权融合
733	  let final_ai_score = basic_ai_score * config.basic_weight +
734	    (1.0 - enhanced_physical_score) * config.enhanced_weight
735	  let final_physical_score = 1.0 - final_ai_score
736	
737	  // 智能决策规则
738	  let mut decision_reason = ""
739	  let mut source_type = ImageSourceType::Unknown
740	  let mut confidence = 0.0
741	
742	  // 强 UI 特征判定
743	  if ui_result.has_window_border &&
744	    ui_result.has_toolbar &&
745	    text_result.text_area_ratio > 0.05 {
746	    source_type = ImageSourceType::PhysicalCaptured
747	    confidence = 0.9
748	    decision_reason = "检测到窗口边框、工具栏和文字区域，强烈判定为屏幕截图（物理生成）"
749	  } else if ui_result.ui_element_count >= 6 &&
750	    geometry_result.geometry_regularity > 0.7 {
751	    source_type = ImageSourceType::PhysicalCaptured	<-- UNCOVERED
752	    confidence = 0.8
753	    decision_reason = "检测到大量 UI 元素和规则几何形状，判定为屏幕截图（物理生成）"
754	  } else if text_result.text_area_ratio > 0.1 &&
755	    color_result.top_10_color_ratio > 0.7 {
756	    source_type = ImageSourceType::PhysicalCaptured
757	    confidence = 0.75
758	    decision_reason = "检测到大量文字区域和集中的颜色分布，判定为屏幕截图（物理生成）"
759	  } else if enhanced_physical_score > 0.65 {
760	    source_type = ImageSourceType::PhysicalCaptured	<-- UNCOVERED
761	    confidence = 0.7
762	    decision_reason = "增强特征综合评分偏向物理生成，判定为物理生成"
763	  } else if final_ai_score >= config.decision_threshold &&
764	    enhanced_physical_score < 0.4 {
765	    source_type = ImageSourceType::AIGenerated
766	    confidence = if final_ai_score > 0.7 { 0.75 } else { 0.55 }
767	    decision_reason = "基础特征和增强特征均偏向 AI 生成，判定为 AI 生成"
768	  } else if final_ai_score >= config.decision_threshold {
769	    source_type = ImageSourceType::AIGenerated
770	    confidence = 0.45
771	    decision_reason = "基础特征偏向 AI 生成，但增强特征存在不确定性，低置信度判定为 AI 生成"
772	  } else {
773	    source_type = ImageSourceType::PhysicalCaptured
774	    confidence = 0.55
775	    decision_reason = "综合特征偏向物理生成，判定为物理生成"
776	  }
777	
778	  (
779	    source_type, final_ai_score, final_physical_score, confidence, decision_reason,
780	  )
781	}
