412	pub fn calculate_ssim_sr(
413	  original : @types.Image,
414	  processed : @types.Image,
415	) -> Double {
416	  let w = original.width
417	  let h = original.height
418	  let total = w * h
419	  let mut sum1 = 0.0
420	  let mut sum2 = 0.0
421	  let mut sum12 = 0.0
422	  let mut sum1_sq = 0.0
423	  let mut sum2_sq = 0.0
424	
425	  for i in 0..<total {
426	    let p1 = original.data[i].to_double()
427	    let p2 = processed.data[i].to_double()
428	    sum1 += p1
429	    sum2 += p2
430	    sum12 += p1 * p2
431	    sum1_sq += p1 * p1
432	    sum2_sq += p2 * p2
433	  }
434	
435	  let mean1 = sum1 / total.to_double()
436	  let mean2 = sum2 / total.to_double()
437	  let var1 = sum1_sq / total.to_double() - mean1 * mean1
438	  let var2 = sum2_sq / total.to_double() - mean2 * mean2
439	  let cov12 = sum12 / total.to_double() - mean1 * mean2
440	
441	  let c1 = 6.5025
442	  let c2 = 58.5225
443	  let numerator = (2.0 * mean1 * mean2 + c1) * (2.0 * cov12 + c2)
444	  let denominator = (mean1 * mean1 + mean2 * mean2 + c1) * (var1 + var2 + c2)
445	
446	  if denominator > 0.0 {
447	    numerator / denominator
448	  } else {
449	    1.0	<-- UNCOVERED
450	  }
451	}
