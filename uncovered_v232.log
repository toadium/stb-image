596	    raise @types.LoadError::DecodeFailed(
597	      "decode_qrcode: 图像尺寸必须大于0",
598	    )
599	  }
600	  if img.channels < 1 || img.channels > 4 {
601	    raise @types.LoadError::DecodeFailed(
602	      "decode_qrcode: 通道数必须在1-4之间",
603	    )
604	  }
605	  let expected_size = img.width * img.height * img.channels
606	  if img.data.length() != expected_size {
607	    raise @types.LoadError::DecodeFailed("decode_qrcode: 数据大小不匹配")
608	  }
609	  let cfg = match config {
610	    Some(c) => c
611	    None => barcode_default_config()
612	  }
613	  if !cfg.enable_qrcode {
614	    return None
615	  }
616	  // 检测定位图案
