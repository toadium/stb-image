721	fn vp8_enc_adaptive_probs_update(probs : Vp8EncAdaptiveProbs) -> Unit {
722	  // 更新 token 概率
723	  for i in 0..<64 {	<-- UNCOVERED
724	    let count = probs.token_counts[i]
725	    if count > 0 {
726	      // EMA 更新：new_prob = old_prob * 0.875 + observed * 0.125
727	      let observed = (255 * count / (count + 1)).clamp(min=1, max=254)	<-- UNCOVERED
728	      probs.token_probs[i] = (probs.token_probs[i] * 7 + observed) / 8
729	      probs.token_counts[i] = 0
730	    }
731	  }
732	  // 更新预测模式概率
733	  let total = probs.pred_mode_counts[0] +
734	    probs.pred_mode_counts[1] +
735	    probs.pred_mode_counts[2] +
736	    probs.pred_mode_counts[3]
737	  if total > 0 {
738	    for i in 0..<4 {	<-- UNCOVERED
739	      let observed = (255 * probs.pred_mode_counts[i] / total).clamp(
740	        min=1,
741	        max=254,
742	      )
743	      probs.pred_mode_probs[i] = (probs.pred_mode_probs[i] * 7 + observed) / 8
744	      probs.pred_mode_counts[i] = 0
745	    }
746	  }
747	  probs.blocks_since_update = 0
748	}
