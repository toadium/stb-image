105	    ixy[i] = ix[i] * iy[i]
106	  }
107	  // 高斯加权（sigma=1, 3x3 核）
108	  let sxx = harris_gaussian_blur(ixx, w, h)
109	  let syy = harris_gaussian_blur(iyy, w, h)
110	  let sxy = harris_gaussian_blur(ixy, w, h)
