318	pub fn generate_confusion_matrix(
319	  predictions : Array[Int],
320	  ground_truth : Array[Int],
321	  num_classes : Int,
322	  class_names : Array[String],
323	) -> ConfusionMatrix {
324	  let matrix : Array[Array[Int]] = []
325	  for _ in 0..<num_classes {
326	    let row : Array[Int] = []
327	    for _ in 0..<num_classes {
328	      row.push(0)
329	    }
330	    matrix.push(row)
331	  }
332	
333	  let mut correct = 0
334	  let total = if predictions.length() < ground_truth.length() {
335	    predictions.length()	<-- UNCOVERED
336	  } else {
337	    ground_truth.length()
338	  }
339	
340	  for i in 0..<total {
341	    let pred = predictions[i]
342	    let gt = ground_truth[i]
343	    if pred >= 0 && pred < num_classes && gt >= 0 && gt < num_classes {
344	      matrix[gt][pred] += 1
345	      if pred == gt {
346	        correct += 1
347	      }
348	    }
349	  }
350	
351	  let accuracy = if total > 0 {
352	    correct.to_double() / total.to_double()
353	  } else {
354	    0.0	<-- UNCOVERED
355	  }
356	
357	  // 计算每个类别的精确率、召回率、F1
358	  let precision : Array[Double] = []
359	  let recall : Array[Double] = []
360	  let f1_scores : Array[Double] = []
361	
362	  for c in 0..<num_classes {
363	    let mut tp = 0
364	    let mut fp = 0
365	    let mut false_neg = 0
366	
367	    for i in 0..<num_classes {
368	      if i == c {
369	        tp = matrix[c][i]
370	      } else {
371	        fp += matrix[i][c]
372	        false_neg += matrix[c][i]
373	      }
374	    }
375	
376	    let p = if tp + fp > 0 {
377	      tp.to_double() / (tp + fp).to_double()
378	    } else {
379	      0.0	<-- UNCOVERED
380	    }
381	    let r = if tp + false_neg > 0 {
382	      tp.to_double() / (tp + false_neg).to_double()
383	    } else {
384	      0.0	<-- UNCOVERED
385	    }
386	    let f1 = if p + r > 0.0 { 2.0 * p * r / (p + r) } else { 0.0 }
387	
388	    precision.push(p)
389	    recall.push(r)
390	    f1_scores.push(f1)
391	  }
392	
393	  ConfusionMatrix::{
394	    matrix,
395	    num_classes,
396	    class_names,
397	    accuracy,
398	    precision,
399	    recall,
400	    f1_scores,
401	  }
402	}
