343	pub fn bilateral_filter_denoise(
344	  img : @types.Image,
345	  kernel_size : Int,
346	  sigma_color : Double,
347	  sigma_space : Double,
348	) -> @types.Image raise @types.LoadError {
349	  // 输入验证
350	  if img.width <= 0 || img.height <= 0 {
