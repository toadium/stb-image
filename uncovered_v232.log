180	fn segment_chinese_chars(
181	  img : @types.Image,
182	  cfg : ChineseOcrConfig,
183	) -> Array[(Int, Int, Int, Int)] {
184	  let w = img.width
185	  let h = img.height
186	  let data = img.data
187	  // 简单连通域标记
188	  let labels : Array[Int] = Array::make(w * h, 0)
189	  let mut next_label = 1
190	  for y in 0..<h {
191	    for x in 0..<w {
192	      if data[y * w + x].to_int() > 128 {
193	        let mut label = 0
194	        if x > 0 && labels[y * w + x - 1] > 0 {
195	          label = labels[y * w + x - 1]
196	        }
197	        if y > 0 && labels[(y - 1) * w + x] > 0 {
198	          if label == 0 {
199	            label = labels[(y - 1) * w + x]
200	          }
201	        }
202	        if label == 0 {
203	          label = next_label
204	          next_label += 1
205	        }
206	        labels[y * w + x] = label
207	      }
208	    }
209	  }
210	  // 计算每个连通域的边界框
211	  let min_x : Array[Int] = Array::make(next_label, w)
212	  let max_x : Array[Int] = Array::make(next_label, 0)
213	  let min_y : Array[Int] = Array::make(next_label, h)
214	  let max_y : Array[Int] = Array::make(next_label, 0)
215	  let area : Array[Int] = Array::make(next_label, 0)
216	  for y in 0..<h {
217	    for x in 0..<w {
218	      let label = labels[y * w + x]
219	      if label > 0 {
220	        area[label] += 1
221	        if x < min_x[label] {
222	          min_x[label] = x
223	        }
224	        if x > max_x[label] {
225	          max_x[label] = x
226	        }
227	        if y < min_y[label] {
228	          min_y[label] = y
229	        }
230	        if y > max_y[label] {
231	          max_y[label] = y
232	        }
233	      }
234	    }
235	  }
236	  // 过滤并返回（中文字符通常接近正方形）
237	  let regions : Array[(Int, Int, Int, Int)] = []
238	  for label in 1..<next_label {
239	    let rw = max_x[label] - min_x[label] + 1
240	    let rh = max_y[label] - min_y[label] + 1
241	    // 中文字符过滤：接近正方形，尺寸在合理范围内
242	    let ratio = if rh > 0 { rw.to_double() / rh.to_double() } else { 0.0 }
243	    if rw >= cfg.min_char_width &&
244	      rw <= cfg.max_char_width &&
245	      rh >= cfg.min_char_width &&
246	      rh <= cfg.max_char_width &&
247	      ratio > 0.5 &&
248	      ratio < 2.0 &&
249	      area[label] > 20 {
250	      regions.push((min_x[label], min_y[label], rw, rh))	<-- UNCOVERED
251	    }
252	  }
253	  regions
254	}
