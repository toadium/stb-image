583	pub fn calculate_correlation(
584	  img1 : @types.Image,
585	  img2 : @types.Image,
586	) -> Double raise @types.LoadError {
587	  // 输入验证
588	  if img1.width <= 0 || img1.height <= 0 {
589	    raise @types.LoadError::DecodeFailed(
590	      "calculate_correlation: 图像尺寸必须大于0",
591	    )
592	  }
593	  if img1.channels < 1 || img1.channels > 4 {
594	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
595	      "calculate_correlation: 通道数必须在1-4之间",
596	    )
597	  }
598	  let expected_size = img1.width * img1.height * img1.channels
599	  if img1.data.length() != expected_size {
600	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
601	      "calculate_correlation: 数据大小不匹配",
602	    )
603	  }
604	  if img2.width <= 0 || img2.height <= 0 {
605	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
606	      "calculate_correlation: 图像尺寸必须大于0",
607	    )
608	  }
609	  if img2.channels < 1 || img2.channels > 4 {
610	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
611	      "calculate_correlation: 通道数必须在1-4之间",
612	    )
613	  }
614	  let expected_size2 = img2.width * img2.height * img2.channels
615	  if img2.data.length() != expected_size2 {
616	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
617	      "calculate_correlation: 数据大小不匹配",
618	    )
619	  }
620	  let w = img1.width
621	  let h = img1.height
622	  let total = w * h
623	  let mut sum1 = 0.0
624	  let mut sum2 = 0.0
625	  let mut sum12 = 0.0
626	  let mut sum1_sq = 0.0
627	  let mut sum2_sq = 0.0
628	
629	  for i in 0..<total {
630	    let p1 = img1.data[i].to_double()
631	    let p2 = img2.data[i].to_double()
632	    sum1 += p1
633	    sum2 += p2
634	    sum12 += p1 * p2
635	    sum1_sq += p1 * p1
636	    sum2_sq += p2 * p2
637	  }
638	
639	  let mean1 = sum1 / total.to_double()
640	  let mean2 = sum2 / total.to_double()
641	  let cov = sum12 / total.to_double() - mean1 * mean2
642	  let var1 = sum1_sq / total.to_double() - mean1 * mean1
643	  let var2 = sum2_sq / total.to_double() - mean2 * mean2
644	
645	  if var1 > 0.0 && var2 > 0.0 {
646	    cov / (var1 * var2).sqrt()
647	  } else {
648	    0.0
649	  }
650	}
