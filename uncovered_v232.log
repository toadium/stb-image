383	fn vp8_select_i16x16_mode(
384	  y_plane : Array[Int],
385	  mb_x : Int,
386	  mb_y : Int,
387	  width : Int,
388	  height : Int,
389	) -> Vp8I16x16PredMode {
390	  // 计算每种预测模式的 SAD（Sum of Absolute Differences）
391	  let modes = [	<-- UNCOVERED
392	    Vp8I16x16PredMode::I16x16DcPred,
393	    Vp8I16x16PredMode::I16x16TrueMotionPred,
394	    Vp8I16x16PredMode::I16x16HPred,
395	    Vp8I16x16PredMode::I16x16VPred,
396	  ]
397	  let mut best_mode = Vp8I16x16PredMode::I16x16DcPred
398	  let mut best_sad = 1000000
399	  for mode in modes {
400	    let pred = match mode {	<-- UNCOVERED
401	      Vp8I16x16PredMode::I16x16DcPred =>
402	        vp8_predict_i16x16_dc(y_plane, mb_x, mb_y, width, height)	<-- UNCOVERED
403	      Vp8I16x16PredMode::I16x16TrueMotionPred =>
404	        vp8_predict_i16x16_tm(y_plane, mb_x, mb_y, width, height)	<-- UNCOVERED
405	      Vp8I16x16PredMode::I16x16HPred =>
406	        vp8_predict_i16x16_h(y_plane, mb_x, mb_y, width, height)	<-- UNCOVERED
407	      Vp8I16x16PredMode::I16x16VPred =>
408	        vp8_predict_i16x16_v(y_plane, mb_x, mb_y, width, height)	<-- UNCOVERED
409	    }
410	    // 计算 SAD
411	    let mut sad = 0
412	    for y in 0..<16 {
413	      for x in 0..<16 {	<-- UNCOVERED
414	        let px = mb_x * 16 + x
415	        let py = mb_y * 16 + y
416	        if px < width && py < height {
417	          let orig = y_plane[py * width + px]	<-- UNCOVERED
418	          let p = pred[y * 16 + x]
419	          sad += (orig - p).abs()	<-- UNCOVERED
420	        }
421	      }
422	    }
423	    if sad < best_sad {
424	      best_sad = sad	<-- UNCOVERED
425	      best_mode = mode
426	    }
427	  }
428	  best_mode
429	}
