537	pub fn calculate_image_entropy(
538	  img : @types.Image,
539	) -> Double raise @types.LoadError {
540	  // 输入验证
541	  if img.width <= 0 || img.height <= 0 {
542	    raise @types.LoadError::DecodeFailed(
543	      "calculate_image_entropy: 图像尺寸必须大于0",
544	    )
545	  }
546	  if img.channels < 1 || img.channels > 4 {
547	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
548	      "calculate_image_entropy: 通道数必须在1-4之间",
549	    )
550	  }
551	  let expected_size = img.width * img.height * img.channels
552	  if img.data.length() != expected_size {
553	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
554	      "calculate_image_entropy: 数据大小不匹配",
555	    )
556	  }
557	  let w = img.width
558	  let h = img.height
559	  let total = w * h
560	  let histogram : Array[Int] = []
561	  for _ in 0..<256 {
562	    histogram.push(0)
563	  }
564	
565	  for i in 0..<total {
566	    let pixel = img.data[i].to_int()
567	    histogram[pixel] += 1
568	  }
569	
570	  let mut entropy = 0.0
571	  for i in 0..<256 {
572	    if histogram[i] > 0 {
573	      let p = histogram[i].to_double() / total.to_double()
574	      entropy -= p * (p * 10.0)
575	    }
576	  }
577	
578	  entropy
579	}
