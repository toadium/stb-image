787	  config : EnhancedVerificationConfig,
788	) -> EnhancedVerificationResult raise @types.LoadError {
789	  // 输入验证
790	  if img.width <= 0 || img.height <= 0 {
791	    raise @types.LoadError::DecodeFailed(
792	      "verify_image_source_enhanced: 图像尺寸必须大于0",
793	    )
794	  }
795	  if img.channels < 1 || img.channels > 4 {
796	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
797	      "verify_image_source_enhanced: 通道数必须在1-4之间",
798	    )
799	  }
800	  let expected_size = img.width * img.height * img.channels
801	  if img.data.length() != expected_size {
802	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
803	      "verify_image_source_enhanced: 数据大小不匹配",
804	    )
