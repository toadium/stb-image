419	fn to_grayscale_ocr(img : @types.Image) -> @types.Image {
420	  if img.channels == 1 {
421	    return img	<-- UNCOVERED
422	  }
423	  let n = img.width * img.height
424	  let ch = img.channels
425	  let out : Array[Byte] = Array::make(n, b'\x00')
426	  let data = img.data
427	  for i in 0..<n {
428	    let base = i * ch
429	    let r = data[base].to_int()
430	    let g = data[base + 1].to_int()
431	    let b = data[base + 2].to_int()
432	    let gray = (r * 299 + g * 587 + b * 114) / 1000
433	    out[i] = gray.to_byte()
434	  }
435	  @types.Image::{
436	    width: img.width,
437	    height: img.height,
438	    channels: 1,
439	    data: Bytes::from_array(out),
440	  }
441	}
