248	      let tmp = a[col]
249	      a[col] = a[max_row]
250	      a[max_row] = tmp
251	      let tmpb = b[col]
252	      b[col] = b[max_row]
253	      b[max_row] = tmpb
254	    }
255	    // 消元
256	    for row in (col + 1)..<n {
257	      let factor = a[row][col] / a[col][col]
258	      for j in col..<n {
259	        a[row][j] -= factor * a[col][j]
260	      }
261	      b[row] -= factor * b[col]
262	    }
263	  }
264	  // 回代
265	  let x : Array[Float] = Array::make(n, 0.0F)
266	  for ii in 0..<n {
267	    let i = n - 1 - ii
268	    let mut sum = b[i]
269	    for j in (i + 1)..<n {
270	      sum -= a[i][j] * x[j]
271	    }
272	    x[i] = sum / a[i][i]
273	  }
