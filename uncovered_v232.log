362	pub fn dbscan_clustering(
363	  data : Array[Array[Double]],
364	  eps : Double,
365	  min_samples : Int,
366	  config : ImageClusteringConfig,
367	) -> DBSCANResult {
368	  ignore(config)
369	  let num_samples = data.length()
370	  let labels : Array[Int] = []
371	  for _ in 0..<num_samples {
372	    labels.push(-1) // -1表示噪声
373	  }
374	
375	  let mut cluster_id = 0
376	  let mut core_count = 0
377	  let mut border_count = 0
378	
379	  for i in 0..<num_samples {
380	    if labels[i] != -1 {
381	      continue
382	    }
383	
384	    // 找邻居
385	    let neighbors : Array[Int] = []
386	    for j in 0..<num_samples {
387	      let dist = euclidean_distance_cl(data[i], data[j])
388	      if dist <= eps {
389	        neighbors.push(j)
390	      }
391	    }
392	
