 862	fn _vp8_intra_predict_4x4(
 863	  mode : Vp8I4x4Mode,
 864	  above : Array[Int],
 865	  left : Array[Int],
 866	  above_left : Int,
 867	) -> Array[Int] {
 868	  let result = Array::make(16, 0)	<-- UNCOVERED
 869	  match mode {
 870	    // 0: DC 预测 - 上方和左方像素的平均值
 871	    I4x4DcPred => {	<-- UNCOVERED
 872	      let mut sum = 0
 873	      for i in 0..<4 {
 874	        sum += above[i]	<-- UNCOVERED
 875	        sum += left[i]
 876	      }
 877	      let dc = (sum + 4) >> 3
 878	      for i in 0..<16 {
 879	        result[i] = dc	<-- UNCOVERED
 880	      }
 881	    }
 882	
 883	    // 1: TrueMotion 预测 - 基于水平和垂直梯度
 884	    // P[y][x] = clip(above[x] + left[y] - above_left, 0, 255)
 885	    I4x4TrueMotionPred =>
 886	      for y in 0..<4 {	<-- UNCOVERED
 887	        for x in 0..<4 {
 888	          let mut pred = above[x] + left[y] - above_left
 889	          if pred < 0 {
 890	            pred = 0	<-- UNCOVERED
 891	          }
 892	          if pred > 255 {
 893	            pred = 255	<-- UNCOVERED
 894	          }
 895	          result[y * 4 + x] = pred
 896	        }
 897	      }
 898	
 899	    // 2: 水平预测 - 使用左方像素
 900	    // P[y][x] = left[y]
 901	    I4x4HPred =>
 902	      for y in 0..<4 {	<-- UNCOVERED
 903	        for x in 0..<4 {
 904	          result[y * 4 + x] = left[y]
 905	        }
 906	      }
 907	
 908	    // 3: 垂直预测 - 使用上方像素
 909	    // P[y][x] = above[x]
 910	    I4x4VPred =>
 911	      for y in 0..<4 {	<-- UNCOVERED
 912	        for x in 0..<4 {
 913	          result[y * 4 + x] = above[x]
 914	        }
 915	      }
 916	
 917	    // 4: LeftDown 预测（左下/对角线，斜率 1）
 918	    // 从左上到右下的对角线预测
 919	    // P[y][x] = (above[x+y] + above[x+y+1] + 1) >> 1  (x+y <= 6)
 920	    // P[y][x] = above[7]  (x+y == 7)
 921	    I4x4LeftDownPred =>
 922	      for y in 0..<4 {	<-- UNCOVERED
 923	        for x in 0..<4 {
 924	          let idx = x + y
 925	          if idx <= 6 {
 926	            result[y * 4 + x] = (above[idx] + above[idx + 1] + 1) >> 1	<-- UNCOVERED
 927	          } else {
 928	            result[y * 4 + x] = above[7]	<-- UNCOVERED
 929	          }
 930	        }
 931	      }
 932	
 933	    // 5: RightDown 预测（右下/对角线，斜率 -1）
 934	    // 从右上到左下的对角线预测
 935	    // 如果 x >= y: P[y][x] = (above[x-y] + above[x-y+1] + 1) >> 1
 936	    // 如果 x < y:  P[y][x] = (left[y-x-1] + left[y-x] + 1) >> 1
 937	    I4x4RightDownPred =>
 938	      for y in 0..<4 {	<-- UNCOVERED
 939	        for x in 0..<4 {
 940	          if x >= y {
 941	            let idx = x - y
 942	            result[y * 4 + x] = (above[idx] + above[idx + 1] + 1) >> 1
