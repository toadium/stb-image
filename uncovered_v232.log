381	pub fn build_document_structure_tree(
382	  blocks : Array[DocumentBlock],
383	) -> Array[DocumentTreeNode] {
384	  // 按阅读顺序排序
385	  let order = optimize_reading_order(blocks, 1)
386	  let ordered_blocks : Array[DocumentBlock] = []
387	  for idx in order {
388	    ordered_blocks.push(blocks[idx])
389	  }
390	  // 构建树（基于标题层级）
391	  let roots : Array[DocumentTreeNode] = []
392	  let stack : Array[DocumentTreeNode] = []
393	  let mut node_id = 0
394	  for block in ordered_blocks {
395	    // 计算深度（基于块类型）
396	    let depth = match block.block_type {
397	      DocumentBlockType::Title => 0
398	      DocumentBlockType::Heading1 => 1	<-- UNCOVERED
399	      DocumentBlockType::Heading2 => 2
400	      DocumentBlockType::Heading3 => 3	<-- UNCOVERED
401	      _ => 4
402	    }
403	    let node = DocumentTreeNode::{ node_id, block, children: [], depth, }
404	    node_id += 1
405	    // 弹出栈中深度 >= 当前深度的节点
406	    while stack.length() > 0 && stack[stack.length() - 1].depth >= depth {
407	      let _ = stack.pop()	<-- UNCOVERED
408	    }
409	    // 如果栈为空，添加到根节点
410	    if stack.length() == 0 {
411	      roots.push(node)
412	    } else {
413	      // 添加为栈顶节点的子节点
414	      let parent = stack[stack.length() - 1]	<-- UNCOVERED
415	      parent.children.push(node)
416	    }
417	    // 将当前节点压入栈
418	    stack.push(node)
419	  }
420	  roots
421	}
