102	      let mut ixy = 0.0F
103	      let mut iyy = 0.0F
104	      let mut ix_it = 0.0F
105	      let mut iy_it = 0.0F
106	      for dy in -half_win..<=half_win {
107	        for dx in -half_win..<=half_win {
108	          let x = px + dx
109	          let y = py + dy
110	          if x < 1 || x >= w - 1 || y < 1 || y >= h - 1 {
111	            continue
112	          }
113	          // 空间梯度（中心差分）
114	          let ix = Float::from_int(
115	              gray_prev[y * w + x + 1] - gray_prev[y * w + x - 1],
116	            ) /
117	            2.0F
118	          let iy = Float::from_int(
119	              gray_prev[(y + 1) * w + x] - gray_prev[(y - 1) * w + x],
120	            ) /
121	            2.0F
122	          // 时间差分：I_t = I_next(x+u, y+v) - I_prev(x, y)
123	          let nx = Float::from_int(x) + u
124	          let ny = Float::from_int(y) + v
125	          let next_val = sample_bilinear_lk(gray_next, w, h, nx, ny)
126	          let prev_val = Float::from_int(gray_prev[y * w + x])
127	          let it = next_val - prev_val
128	          // 累加 A^T A 和 A^T b
129	          ixx += ix * ix
130	          ixy += ix * iy
131	          iyy += iy * iy
132	          ix_it += ix * it
133	          iy_it += iy * it
134	        }
135	      }
136	      // 求解 2x2 线性方程
137	      let det = ixx * iyy - ixy * ixy
138	      if det.abs() < 0.01F {
139	        break
140	      }
141	      let du = -(iyy * ix_it - ixy * iy_it) / det
142	      let dv = -(ixx * iy_it - ixy * ix_it) / det
143	      u += du
144	      v += dv
145	      // 收敛检测
146	      if du.abs() < 0.01F && dv.abs() < 0.01F {
147	        found = true
148	        break
149	      }
150	      found = true
151	    }
152	    results.push(FlowResult::{
153	      x: Float::from_int(px),
154	      y: Float::from_int(py),
155	      u,
156	      v,
157	      found,
158	    })
159	  }
160	  results
161	}
