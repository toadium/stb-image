285	pub fn arnold_scramble(
286	  img : @types.Image,
287	  params : ArnoldParams,
288	) -> EncryptionResult raise @types.LoadError {
289	  // 输入验证
290	  if img.width <= 0 || img.height <= 0 {
291	    raise @types.LoadError::DecodeFailed(
292	      "arnold_scramble: 图像尺寸必须大于0",
293	    )
294	  }
295	  if img.channels < 1 || img.channels > 4 {
296	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
297	      "arnold_scramble: 通道数必须在1-4之间",
298	    )
299	  }
300	  let expected_size = img.width * img.height * img.channels
301	  if img.data.length() != expected_size {
302	    raise @types.LoadError::DecodeFailed(	<-- UNCOVERED
303	      "arnold_scramble: 数据大小不匹配",
304	    )
305	  }
306	  let w = img.width
307	  let h = img.height
308	  let total = w * h
309	  let scrambled : Array[Byte] = []
310	  for _ in 0..<total {
311	    scrambled.push(b'\x00')
312	  }
313	
314	  let mut current = img.data
315	  for _ in 0..<params.iterations {
316	    let next : Array[Byte] = []
317	    for _ in 0..<total {
318	      next.push(b'\x00')
319	    }
320	    for y in 0..<h {
321	      for x in 0..<w {
322	        let new_x = (x + params.a * y) % w
323	        let new_y = (params.b * x + (params.a * params.b + 1) * y) % h
324	        next[new_y * w + new_x] = current[y * w + x]
325	      }
326	    }
327	    current = Bytes::from_array(next)
328	  }
329	
330	  for i in 0..<total {
331	    scrambled[i] = current[i]
332	  }
333	
334	  EncryptionResult::{
335	    encrypted_data: scrambled,
336	    width: w,
337	    height: h,
338	    channels: img.channels,
339	    algorithm: EncryptionAlgorithm::Arnold,
340	    key_hash: "arnold_key_hash",
341	    encryption_time_ms: 0.0,
342	    file_size_original: total,
343	    file_size_encrypted: total,
344	  }
345	}
